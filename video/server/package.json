{
  "name": "corpvideo-server",
  "version": "1.13.0",
  "description": "CorpVideo — корпоративный видеохостинг: API-сервер и воркер обработки видео",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/cli.js migrate",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/portal.test.js",
    "test:portal": "node --test test/portal.test.js test/portal-sync.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ldapts": "^8.0.5",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1"
  }
}
