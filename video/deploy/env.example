# Раздел «Видео» портала документации — настройки видеопортала (CorpVideo).
#
# На сервере файл создаёт команда «docportal video enable»: /etc/docportal/video.env (владелец root,
# читает служба видеопортала). При обновлении портала служебные параметры перезаписываются, а свои
# параметры, добавленные в конец файла, сохраняются. В Docker те же параметры задаются в docker/.env
# переменными VIDEO_* (см. docker/.env.example), сюда смотреть не нужно.

# --- Общие ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
# Префикс раздела на сайте портала и его внешний адрес (из него строятся ссылки в письмах и уведомлениях).
BASE_PATH=/video
BASE_URL=https://docs.example.ru/video
SECRET_KEY=длинная-случайная-строка
LOG_LEVEL=info
# Запросы приходят только от nginx портала (API слушает 127.0.0.1).
TRUST_PROXY=1
# Медиафайлы и скачивание оригиналов отдаёт nginx портала (X-Accel-Redirect).
NGINX_ACCEL=1

# --- База данных (PostgreSQL) ---
DATABASE_URL=postgres://corpvideo:пароль@127.0.0.1:5432/corpvideo
DB_PASSWORD=пароль

# --- Каталоги ---
DATA_DIR=/var/lib/docportal-video
WEB_DIST=/opt/docportal/current/video/web/dist

# --- Общий вход с порталом документации ---
# Видеопортал проверяет сессию портала по внутреннему адресу (отдельный сервер nginx на 127.0.0.1:8079)
# и подписывает запрос секретом. Секрет тот же, что VIDEO_SHARED_SECRET в настройках портала
# (/opt/docportal/shared/.env.local), не короче 24 символов.
PORTAL_INTERNAL_URL=http://127.0.0.1:8079
PORTAL_SHARED_SECRET=общий-секрет
PORTAL_NAME=Портал документации
# Если портал открыт не в корне сайта (редко): PORTAL_PUBLIC_PATH=/docs
# PORTAL_PUBLIC_PATH=
# Сколько миллисекунд помнить ответ портала по одной сессии (меньше — быстрее видна блокировка и смена роли).
# PORTAL_SESSION_CACHE_MS=10000
# Сотрудники портала → учётные записи и группы-подразделения видеопортала: раз в столько минут (0 — нет).
# PORTAL_SYNC_MINUTES=15
# Уведомления о задачах (модерация, обязательные просмотры…) — письмом и в Telegram через портал (0 — нет).
# PORTAL_NOTIFY=1

# --- Обработка видео ---
WORKER_CONCURRENCY=2
# FFMPEG_PATH=ffmpeg
# FFMPEG_THREADS=0
# WORKER_LONG_CONCURRENCY=8
# PREVIEW_CONCURRENCY=3

# --- Исходящие запросы ---
# OUTBOUND_ALLOW_LOCAL=1
# IMPORT_ALLOW_LOCAL=1

# --- Трансляции (MediaMTX) ---
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
MEDIAMTX_HOOK_SECRET=секрет-для-хуков
# Публичные адреса, которые видят авторы трансляций:
LIVE_RTMP_URL=rtmp://docs.example.ru:1935
LIVE_SRT_URL=srt://docs.example.ru:8890
LIVE_WHIP_URL=https://docs.example.ru/video/whip
