# ==============================================================================
#  Пример локальных настроек для РУЧНОЙ установки (скрипт deploy/install.sh создаёт
#  файл .env.local автоматически). Скопируйте в .env.local и заполните значения.
#  Полное описание параметров — в файле .env и в docs/РУКОВОДСТВО.md.
# ==============================================================================
APP_ENV=prod
APP_DEBUG=0
# Случайная строка (например: openssl rand -hex 32)
APP_SECRET=
APP_NAME="Портал документации"
APP_COMPANY="ВОДОКОМФОРТ"
APP_DEFAULT_URI=https://docs.example.ru
APP_TIMEZONE=Europe/Moscow
# Пароль в URL кодируйте (например, символ @ → %40)
DATABASE_URL="mysql://docportal:ПАРОЛЬ@127.0.0.1:3306/docportal?serverVersion=8.0&charset=utf8mb4"
STORAGE_DIR=%kernel.project_dir%/var/storage
UPLOAD_MAX_MB=100
TRUSTED_PROXIES=
# Почта: smtp://user:pass@mail.example.ru:587 или null://null (не отправлять)
MAILER_DSN=null://null
MAIL_FROM="Портал документации <noreply@example.ru>"
# Active Directory: включите и укажите контроллер домена (остальные параметры — см. .env)
LDAP_ENABLED=0
LDAP_HOST=dc.example.local
LDAP_BASE_DN="DC=example,DC=local"
LDAP_UPN_SUFFIX="example.local"
