# =============================================================================
#  Параметры Docker-развёртывания портала документации.
#  Скопируйте в docker/.env и заполните. Скрипт deploy/install.sh --mode docker создаёт файл сам.
# =============================================================================

# Имя проекта Compose (префикс контейнеров и томов).
COMPOSE_PROJECT_NAME=docportal
# Порт на сервере, на котором будет доступен портал.
HTTP_PORT=80
# Часовой пояс контейнеров.
TZ=Europe/Moscow
# Расписание проверки сроков актуальности (формат cron, по умолчанию ежедневно в 08:00).
EXPIRY_CRON=0 8 * * *
# Расписание формирования описаний документов через LLM (работает, если интеграция включена в панели администратора).
DESCRIBE_CRON=20 * * * *
# Расписание индексации содержимого документов для полнотекстового поиска.
REINDEX_CRON=40 * * * *
# Расписание напоминаний об ознакомлении с документами.
ACKNOWLEDGE_CRON=30 8 * * *
# Каталог импорта документов (папки → разделы, файлы → документы): имя тома Docker (import)
# или абсолютный путь к каталогу на сервере, например /srv/docportal-import — тогда папки
# с документами можно класть прямо туда и запускать импорт в панели администратора.
IMPORT_HOST_DIR=import

# Образы. При недоступности Docker Hub укажите зеркало, например mirror.gcr.io/library/mysql:8.0
MYSQL_IMAGE=mysql:8.0
NGINX_IMAGE=nginx:1.27-alpine
PHP_IMAGE=php:8.4-fpm-alpine
APP_IMAGE=docportal:latest

# База данных (создаётся автоматически при первом запуске).
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=docportal
MYSQL_USER=docportal
MYSQL_PASSWORD=change_me_db_password

# Приложение (описание параметров — в файле .env в корне проекта).
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_to_a_random_64_hex_string
APP_NAME=Портал документации
APP_COMPANY=ВОДОКОМФОРТ
APP_DEFAULT_URI=http://localhost
APP_TIMEZONE=Europe/Moscow
UPLOAD_MAX_MB=100
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,txt,csv,md,png,jpg,jpeg,gif,svg,zip,7z,rar,dwg,dxf,xml,json
EXPIRY_SOON_DAYS=30
DEFAULT_VALIDITY_MONTHS=12
PASSWORD_MIN_LENGTH=8
# Начальный режим просмотра открытых документов без входа: all | ip | off (далее — панель администратора → Настройки).
GUEST_ACCESS_DEFAULT=all
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_GLOBAL=25
LOGIN_ATTEMPT_INTERVAL=15 minutes
SESSION_LIFETIME=43200
REMEMBER_ME_LIFETIME=1209600
# Внутренние сети Docker — чтобы приложение доверяло заголовкам X-Forwarded-* от nginx.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Почта (уведомления о сроках). null://null — письма только в журнал.
MAILER_DSN=null://null
MAIL_FROM=Портал документации <noreply@example.ru>
NOTIFY_ADMINS=1

# Active Directory / LDAP (см. описание в .env).
LDAP_ENABLED=0
LDAP_HOST=dc.example.local
LDAP_PORT=389
LDAP_ENCRYPTION=none
LDAP_BASE_DN=DC=example,DC=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_UPN_SUFFIX=example.local
LDAP_UID_KEY=sAMAccountName
LDAP_FILTER=(&(objectClass=user)(objectCategory=person)({uid_key}={username}))
LDAP_NAME_ATTR=displayName
LDAP_MAIL_ATTR=mail
LDAP_ADMIN_GROUP=
LDAP_USER_GROUP=

# Первый администратор (создаётся при запуске, если ещё не существует).
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_admin_password
