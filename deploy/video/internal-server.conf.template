# Раздел «Видео» портала документации: проверка сессии портала для видеопортала.
# Отдельный сервер только на ${INTERNAL_LISTEN} (снаружи недоступен): видеопортал передаёт сюда cookie
# браузера и общий секрет (VIDEO_SHARED_SECRET), портал отвечает, кто вошёл. Создаётся deploy/video.sh.
server {
    listen ${INTERNAL_LISTEN};
    server_name _;
    root ${PUBLIC_ROOT};
    access_log off;
    # Видеопортал сообщает, по какому протоколу открыт сайт: cookie «Запомнить меня», выданные
    # заново, получают флаг Secure так же, как при обычном входе по HTTPS.
    set $docportal_video_https "";
    if ($http_x_forwarded_proto = "https") {
        set $docportal_video_https on;
    }
    location = /internal/video/session {
        fastcgi_pass ${FASTCGI_PASS};
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME ${SCRIPT_ROOT}/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT ${SCRIPT_ROOT};
        fastcgi_param HTTPS $docportal_video_https;
        fastcgi_read_timeout 30;
    }
    location / {
        return 404;
    }
}
