{# Окно помощника: mode = panel (кнопка «Помощник» на всех страницах) или page (страница /assistant). #}
{% set mode = mode|default('panel') %}
<div class="assistant assistant--{{ mode }}" data-assistant data-mode="{{ mode }}"{% if current|default(null) %} data-current="{{ current }}"{% endif %}>
    <script type="application/json" data-assistant-config>{{ assistant_config()|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
    {% if mode == 'panel' %}
        <button class="assistant__fab" type="button" data-assistant-toggle aria-expanded="false" aria-controls="assistant-panel" title="Помощник: ответы по документам, видео и прайс-листам">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/><path d="M8.5 10.5h7M8.5 14h4.5"/></svg>
            <span class="assistant__fab-text">Помощник</span>
        </button>
    {% endif %}
    <section class="assistant__panel" id="{{ mode == 'panel' ? 'assistant-panel' : 'assistant-page' }}" {{ mode == 'panel' ? 'hidden role=dialog aria-modal=false' : '' }} aria-label="Помощник">
        <header class="assistant__head">
            <div class="assistant__title">
                <b>Помощник</b>
                <span>ответы по документам, видео и прайс-листам портала</span>
            </div>
            <div class="assistant__tools">
                {% if mode == 'panel' and not setup|default(false) %}<button type="button" class="assistant__tool" data-assistant-list-toggle title="Мои разговоры" aria-label="Мои разговоры"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg></button>{% endif %}
                {% if not setup|default(false) %}<button type="button" class="assistant__tool" data-assistant-new title="Новый разговор" aria-label="Новый разговор"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>{% endif %}
                {% if mode == 'panel' %}
                    <a class="assistant__tool" href="{{ path('app_assistant') }}" data-assistant-expand title="Открыть на всю страницу" aria-label="Открыть на всю страницу"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></svg></a>
                    <button type="button" class="assistant__tool" data-assistant-close title="Закрыть" aria-label="Закрыть"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
                {% endif %}
            </div>
        </header>
        {% if setup|default(false) %}
        <div class="assistant__body assistant__body--setup">
            <div class="assistant__setup">
                <p><b>Помощнику не подключена языковая модель</b> — поэтому сотрудники кнопку «Помощник» пока не видят (эту подсказку видят только администраторы).</p>
                <p>Подключите модель одним из способов:</p>
                <ol>
                    <li><b>На сервере портала</b> (Ollama и модель по объёму памяти, 5–15 минут):<br><code>sudo docportal ai enable</code></li>
                    <li><b>На отдельном сервере</b> с видеокартой: на нём <code>sudo bash ai-server.sh --allow IP_портала</code> (скрипт — в <code>deploy/</code> дистрибутива), затем на сервере портала команда, которую он выведет: <code>sudo docportal ai connect --url … --api-key … --model …</code></li>
                    <li><b>Облачный сервис</b> или свой сервер vLLM / Ollama — адрес, модель и ключ в настройках.</li>
                </ol>
                <p><a class="btn btn--pill btn--small" href="{{ path('admin_integrations') }}#assistant">Настройки помощника</a></p>
                <p class="hints">Проверить на сервере: <code>docportal ai status</code>. Подробно — РУКОВОДСТВО, раздел 7.7.</p>
            </div>
        </div>
        {% else %}
        <div class="assistant__body">
            <nav class="assistant__list" data-assistant-list {{ mode == 'panel' ? 'hidden' }} aria-label="Мои разговоры">
                <div class="assistant__list-head">Мои разговоры</div>
                <ul data-assistant-list-items>
                    {% for c in conversations|default([]) %}
                        <li><a href="{{ path('app_assistant', {c: c.id}) }}" data-id="{{ c.id }}" class="{{ c.id == current|default(0) ? 'is-active' }}"><span>{{ c.title }}</span><small>{{ c.channel != 'web' ? c.channel_label ~ ' · ' }}{{ c.updated }}</small></a></li>
                    {% endfor %}
                </ul>
                <p class="assistant__list-empty" data-assistant-list-empty {{ conversations|default([]) is not empty ? 'hidden' }}>Разговоров пока нет.</p>
            </nav>
            <div class="assistant__chat">
                <div class="assistant__log" data-assistant-log aria-live="polite">
                    <div class="assistant__welcome" data-assistant-welcome>
                        <p>Спросите о порядке работы, документе или цене — помощник найдёт ответ в материалах портала, к которым у вас есть доступ, и даст ссылки на них. Можно уточнять: «а для скважины?», «а сколько стоит?».</p>
                        <div class="assistant__examples">
                            {% for example in ['Как оформить командировку?', 'Сколько стоит гидроаккумулятор 50 л?', 'Где инструкция по охране труда?'] %}
                                <button type="button" class="chip chip--small" data-assistant-example>{{ example }}</button>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <form class="assistant__form" data-assistant-form>
                    <textarea class="assistant__input" name="message" rows="1" maxlength="1000" placeholder="Спросите о документе, порядке работы или цене…" aria-label="Вопрос помощнику" required></textarea>
                    <button type="submit" class="assistant__send" aria-label="Отправить" title="Отправить (Enter)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg></button>
                </form>
                <p class="assistant__note">Ответ готовит {{ assistant_config().model ? 'ИИ' : 'портал' }} по материалам портала — сверяйтесь с источниками по ссылкам.</p>
            </div>
        </div>
        {% endif %}
    </section>
</div>
