{% extends 'admin/_layout.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Реестр документов{% endblock %}
{% block admin_title %}Реестр документов{% endblock %}
{% block admin_actions %}
    <a class="btn btn--pill" href="{{ path('app_document_new') }}">Добавить документ</a>
    <a class="btn btn--ghost" href="{{ path('admin_documents_export', app.request.query.all) }}">Выгрузить CSV</a>
{% endblock %}

{% block admin_body %}
<div class="card toolbar">
    <form method="get" class="filters" data-filters>
        <label class="search">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input class="search__input" type="search" name="q" value="{{ filters.q }}" placeholder="Название или обозначение">
        </label>
        <select class="form-control form-control--inline" name="section" aria-label="Раздел"><option value="">Все разделы</option>{{ m.section_option_tree(tree, filters.section) }}</select>
        <select class="form-control form-control--inline" name="status" aria-label="Статус">
            <option value="">Любой статус</option>
            {% for value, label in {published: 'Опубликован', draft: 'Черновик', archived: 'В архиве'} %}<option value="{{ value }}" {{ filters.status == value ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
        <select class="form-control form-control--inline" name="type" aria-label="Вид">
            <option value="">Любой вид</option><option value="file" {{ filters.type == 'file' ? 'selected' }}>Файлы</option><option value="page" {{ filters.type == 'page' ? 'selected' }}>Страницы</option>
        </select>
        <select class="form-control form-control--inline" name="validity" aria-label="Актуальность">
            <option value="">Любая актуальность</option>
            {% for value, label in {expired: 'Просрочены', soon: 'Истекают', valid: 'Актуальны', none: 'Бессрочные'} %}<option value="{{ value }}" {{ filters.validity == value ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
        <select class="form-control form-control--inline" name="access" aria-label="Доступ">
            <option value="">Любой доступ</option><option value="public" {{ filters.access == 'public' ? 'selected' }}>Открытые (без входа)</option><option value="internal" {{ filters.access == 'internal' ? 'selected' }}>Внутренние (после входа)</option>
        </select>
        <select class="form-control form-control--inline" name="owner" aria-label="Ответственный">
            <option value="">Любой ответственный</option>
            {% for u in owners %}<option value="{{ u.id }}" {{ filters.owner and filters.owner.id == u.id ? 'selected' }}>{{ u.displayName }}</option>{% endfor %}
        </select>
        <select class="form-control form-control--inline" name="sort" aria-label="Сортировка">
            {% for value, label in {updated: 'по обновлению', title: 'по названию', code: 'по обозначению', valid: 'по сроку', views: 'по популярности'} %}<option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
        <button class="btn btn--ghost btn--small" type="submit">Показать</button>
        <a class="btn btn--ghost btn--small" href="{{ path('admin_documents') }}">Сбросить</a>
    </form>
</div>
<form method="post" id="bulk-form" action="{{ path('admin_documents_bulk') }}" data-bulk>
    <input type="hidden" name="_token" value="{{ csrf_token('documents_bulk') }}">
</form>
<div class="card table-card">
    <div class="card__head card__head--padded">
        <h2 class="h-section">Найдено: {{ documents|length }}</h2>
        <span class="hints">Отметьте документы, чтобы выполнить действие сразу над несколькими (не больше {{ bulk_max }} за раз).</span>
    </div>
    {{ m.document_table(documents, {show_section: true, show_status: true, selectable: true, empty: 'Документов с такими условиями нет.'}) }}
    <div class="bulk-bar" data-bulk-bar hidden>
        <span class="bulk-bar__count">Отмечено: <b data-bulk-count>0</b></span>
        <select class="form-control form-control--inline" name="action" form="bulk-form" data-bulk-action aria-label="Действие">
            {% for value, label in actions %}<option value="{{ value }}">{{ label }}</option>{% endfor %}
        </select>
        <span class="bulk-bar__field" data-bulk-for="move">
            <select class="form-control form-control--inline" name="section" form="bulk-form" aria-label="Раздел"><option value="">Выберите раздел</option>{{ m.section_option_tree(tree, null) }}</select>
        </span>
        <span class="bulk-bar__field" data-bulk-for="validity">
            <input class="form-control form-control--inline" type="date" name="valid_until" form="bulk-form" aria-label="Актуален до">
            <span class="hints">пусто — снять срок</span>
        </span>
        <span class="bulk-bar__field" data-bulk-for="tags">
            <input class="form-control form-control--inline" type="text" name="tags" form="bulk-form" placeholder="теги через запятую" aria-label="Теги">
        </span>
        <span class="bulk-bar__field" data-bulk-for="access">
            <select class="form-control form-control--inline" name="access" form="bulk-form" aria-label="Доступ"><option value="internal">внутренние</option><option value="public">открытые (без входа)</option></select>
        </span>
        <button type="submit" form="bulk-form" class="btn btn--pill btn--small" data-bulk-submit data-confirm-delete="Удалить отмеченные документы со всеми версиями? Действие необратимо.">Выполнить</button>
    </div>
</div>
{% endblock %}
