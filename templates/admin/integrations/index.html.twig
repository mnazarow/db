{% extends 'admin/_layout.html.twig' %}

{% block title %}Интеграции{% endblock %}
{% block admin_title %}Интеграции{% endblock %}
{% block admin_actions %}
    <a class="btn btn--ghost" href="#api-keys">Ключи API</a>
    <a class="btn btn--ghost" href="#webhook">Webhook</a>
    <a class="btn btn--ghost" href="#llm">Языковая модель</a>
    <a class="btn btn--ghost" href="#semantic">Поиск по смыслу</a>
    <a class="btn btn--ghost" href="#discussion">Обсуждение</a>
    <a class="btn btn--ghost" href="#telegram">Telegram</a>
    <a class="btn btn--ghost" href="#onlyoffice">Редактор документов</a>
{% endblock %}

{% block admin_body %}
{% if new_token %}
<div class="card card--token" id="new-token">
    <h2 class="h-section">Новый ключ API создан</h2>
    <p>Скопируйте ключ сейчас и сохраните в настройках внешней системы — в портале хранится только его хэш, повторно ключ не показывается.</p>
    <div class="token-row">
        <input class="form-control token-row__value" id="new-token-value" type="text" readonly value="{{ new_token }}" onclick="this.select()">
        <button type="button" class="btn btn--pill btn--small" data-copy="#new-token-value">Скопировать</button>
    </div>
    <pre class="code-block">curl -H "Authorization: Bearer {{ new_token }}" {{ api_base }}/documents?per_page=5</pre>
</div>
{% endif %}

<div class="grid grid--two" id="api-keys">
    <div class="card table-card">
        <div class="card__head card__head--padded"><h2 class="h-section">Ключи REST API</h2>
            <span class="badge {{ keys|filter(k => k.enabled)|length > 0 ? 'badge--done' : 'badge--none' }}"><span class="badge__dot"></span>{{ keys|filter(k => k.enabled)|length|plural(['активный ключ', 'активных ключа', 'активных ключей']) }}</span></div>
        {% if keys|length == 0 %}
            <div class="table-card__empty">Ключей пока нет. Создайте ключ для индексатора RAG или другой внешней системы.</div>
        {% else %}
        <div class="table-scroll"><table class="admin-table keys-table">
            <thead><tr><th>Название</th><th>Ключ</th><th>Документы</th><th>Запросов</th><th>Последний запрос</th><th class="col-actions"></th></tr></thead>
            <tbody>
            {% for key in keys %}
                <tr class="{{ not key.enabled ? 'is-inactive' }}">
                    <td><b>{{ key.name }}</b><div class="hints">создан {{ key.createdAt|date('d.m.Y') }}{% if key.createdBy %} · {{ key.createdBy.displayName }}{% endif %}{% if not key.enabled %} · <span class="text-danger">отключён</span>{% endif %}</div></td>
                    <td><code>{{ key.tokenPrefix }}…</code></td>
                    <td>{% if key.includeInternal %}<span class="tag tag--internal">все, включая внутренние</span>{% else %}только открытые{% endif %}</td>
                    <td class="col-num">{{ key.requestCount }}</td>
                    <td class="col-nowrap">{% if key.lastUsedAt %}{{ key.lastUsedAt|date('d.m.Y H:i') }}<div class="hints">{{ key.lastUsedIp }}</div>{% else %}—{% endif %}</td>
                    <td class="col-actions">
                        <div class="row-actions">
                            <form method="post" action="{{ path('admin_integrations_key_toggle', {id: key.id}) }}" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('integrations') }}"><button type="submit" class="btn btn--ghost btn--small">{{ key.enabled ? 'Отключить' : 'Включить' }}</button></form>
                            <form method="post" action="{{ path('admin_integrations_key_delete', {id: key.id}) }}" class="inline-form" data-confirm="Удалить ключ «{{ key.name }}»? Внешняя система с этим ключом потеряет доступ."><input type="hidden" name="_token" value="{{ csrf_token('integrations') }}"><button type="submit" class="btn btn--ghost btn--small btn--danger">Удалить</button></form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table></div>
        {% endif %}
        <div class="card__padded">
            <form method="post" action="{{ path('admin_integrations_key_create') }}" class="form">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <div class="form-row">
                    <label class="form-label" for="key-name">Новый ключ</label>
                    <div class="toolbar__row toolbar__row--compact">
                        <input class="form-control form-control--inline" id="key-name" name="name" maxlength="128" placeholder="Например: Индексатор RAG" required>
                        <label class="form-check form-check--inline"><input type="checkbox" name="include_internal" value="1"><span>включая внутренние документы</span></label>
                        <button type="submit" class="btn btn--pill btn--small">Создать ключ</button>
                    </div>
                    <div class="form-help">Ключ видит только опубликованные документы; черновики через API недоступны. Без флажка внешней системе отдаются лишь <b>открытые</b> документы (как гостям портала).</div>
                </div>
            </form>
        </div>
    </div>
    <div class="card card--info">
        <h2 class="h-section">API для выгрузки в RAG</h2>
        <p>Базовый адрес: <code>{{ api_base }}</code>. Ключ передаётся заголовком <code>Authorization: Bearer &lt;ключ&gt;</code> или <code>X-Api-Key: &lt;ключ&gt;</code>. Ответы — JSON в UTF-8; ошибки — <code>{"error": {"code", "message"}}</code>.</p>
        <table class="api-table">
            <tbody>
            <tr><td><code>GET /sections</code></td><td>дерево разделов (плоский список с <code>parent_id</code>)</td></tr>
            <tr><td><code>GET /documents</code></td><td>список документов: <code>updated_since</code>, <code>section</code>, <code>type</code>, <code>status=published|archived|all</code>, <code>tag</code>, <code>q</code>, <code>page</code>, <code>per_page</code> (до 200)</td></tr>
            <tr><td><code>GET /documents/{id}</code></td><td>карточка, версии и извлечённый текст (<code>text=0</code> — без текста)</td></tr>
            <tr><td><code>GET /documents/{id}/text</code></td><td>текст версии (<code>version=N</code>) — для эмбеддингов</td></tr>
            <tr><td><code>GET /documents/{id}/content</code></td><td>исходный файл или HTML страницы</td></tr>
            <tr><td><code>GET /changes?since=…</code></td><td>изменившиеся, скрытые и удалённые документы с момента <code>since</code> — для инкрементальной синхронизации</td></tr>
            <tr><td><code>GET /search?q=…</code></td><td>поиск как на портале</td></tr>
            </tbody>
        </table>
        <p class="form-help">Текст извлекается из страниц, txt/md/csv/html, {{ extraction.pdf ? 'PDF (pdftotext установлен)' : 'PDF — <b>pdftotext не установлен</b> (пакет poppler-utils)' }}, docx/xlsx/pptx и odt/ods/odp. Обращения через API не учитываются в статистике просмотров. Подробнее — в руководстве, раздел «Интеграции».</p>
    </div>
</div>

<div class="grid grid--two" id="webhook">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Webhook об изменениях</h2>
            {% if webhook.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>Включён</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>{% endif %}</div>
        <p>После каждого изменения документов (создание, новая версия, публикация, архив, перемещение, удаление) портал отправляет на указанный адрес POST-запрос с JSON <code>{"event": "documents.changed", "changes": [...], "deleted": [...]}</code> — только идентификаторы документов и типы событий, без названий. Внешняя система по нему запускает синхронизацию через <code>/changes</code>.</p>
        <form method="post" action="{{ path('admin_integrations_webhook') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ webhook.enabled ? 'checked' }}><span>Отправлять webhook при изменениях документов</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="webhook-url">Адрес (URL)</label>
                <input class="form-control" id="webhook-url" name="url" type="url" placeholder="https://rag.example.local/hooks/docportal" value="{{ webhook.url }}">
            </div>
            <div class="form-row">
                <label class="form-label" for="webhook-secret">Секрет для подписи</label>
                <input class="form-control" id="webhook-secret" name="secret" type="password" autocomplete="new-password" placeholder="{{ webhook.secret ? 'сохранён (' ~ webhook.secret_masked ~ ') — введите новый, чтобы заменить' : 'не задан' }}">
                <div class="form-help">Если задан, запрос содержит заголовок <code>X-Docportal-Signature: sha256=HMAC-SHA256(тело, секрет)</code>.{% if webhook.secret %} <label class="form-check form-check--inline"><input type="checkbox" name="clear_secret" value="1"><span>удалить секрет</span></label>{% endif %}</div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
        {% if webhook.url %}
        <form method="post" action="{{ path('admin_integrations_webhook_test') }}" class="form-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <button type="submit" class="btn btn--ghost btn--small">Отправить пробный запрос</button>
        </form>
        {% endif %}
    </div>
    <div class="card card--info">
        <h2 class="h-section">Как синхронизировать индекс</h2>
        <p><b>Первичная загрузка.</b> Пройдите <code>GET /documents?per_page=200&amp;page=1…N</code>, для каждого документа возьмите <code>text</code> из карточки или <code>/documents/{id}/text</code>, разбейте на фрагменты и сохраните эмбеддинги вместе с <code>id</code>, <code>version.number</code>, <code>section.full_name</code>, <code>links.web</code>.</p>
        <p><b>Обновления.</b> Периодически (или по webhook) вызывайте <code>GET /changes?since=&lt;next_since прошлого раза&gt;</code>: документы из <code>changed</code> переиндексируйте, из <code>removed</code> и <code>deleted</code> — удалите из индекса. Если в ответе <code>truncated: true</code>, повторите запрос с меньшим окном.</p>
        <p>Webhook отправляется один раз без повторов (тайм-аут 10 с); при недоставке достаточно регулярного опроса <code>/changes</code>.</p>
    </div>
</div>

<div class="grid grid--two" id="discussion">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Обсуждение и подписки</h2></div>
        <p>Обсуждение — вопросы сотрудников прямо в карточке документа; их видят все, кому открыт документ. Подписка — уведомления о новых редакциях, публикации и сообщениях: по почте и, если настроен бот, в Telegram.</p>
        <form method="post" action="{{ path('admin_integrations_discussion') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="comments" value="1" {{ comments_enabled ? 'checked' }}><span>Разрешить обсуждение документов</span></label>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="subscriptions" value="1" {{ subscriptions_enabled ? 'checked' }}><span>Разрешить подписку на изменения документов и разделов</span></label>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
    </div>
    <div class="card card--info">
        <h2 class="h-section">Что уже отслеживают</h2>
        <dl class="meta meta--stack">
            <div><dt>Подписок на документы</dt><dd>{{ subscription_summary.documents }}</dd></div>
            <div><dt>Подписок на разделы</dt><dd>{{ subscription_summary.sections }}</dd></div>
            <div><dt>Сотрудников с подписками</dt><dd>{{ subscription_summary.users }}</dd></div>
        </dl>
        <p class="hints">Уведомления не раскрывают документы с ограниченным доступом: перед отправкой портал проверяет право каждого получателя видеть документ.</p>
    </div>
</div>

<div class="grid grid--two" id="telegram">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Уведомления в Telegram</h2>
            {% if telegram.enabled and telegram.token %}<span class="badge badge--done"><span class="badge__dot"></span>Включены</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключены</span>{% endif %}</div>
        <p>Создайте бота у @BotFather, вставьте сюда его токен и включите уведомления. Портал только отправляет запросы наружу и сам забирает сообщения (getUpdates) — открывать порт под webhook не нужно. В закрытом контуре укажите адрес внутреннего Bot API Server вместо {{ telegram.default_api }}.</p>
        <form method="post" action="{{ path('admin_integrations_telegram') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ telegram.enabled ? 'checked' }}><span>Отправлять уведомления в Telegram</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="telegram-token">Токен бота</label>
                <input class="form-control" id="telegram-token" name="token" type="password" autocomplete="new-password" placeholder="{{ telegram.token ? 'сохранён (' ~ telegram.token_masked ~ ') — введите новый, чтобы заменить' : '123456789:AA…' }}">
                {% if telegram.token %}<div class="form-help"><label class="form-check form-check--inline"><input type="checkbox" name="clear_token" value="1"><span>удалить токен</span></label></div>{% endif %}
            </div>
            <div class="form-row">
                <label class="form-label" for="telegram-bot">Имя бота</label>
                <input class="form-control" id="telegram-bot" name="bot_name" type="text" placeholder="docportal_bot" value="{{ telegram.bot_name }}">
                <div class="form-help">Нужно для ссылки «Открыть чат с ботом» в профиле сотрудника; заполняется само при проверке связи.</div>
            </div>
            <div class="form-row">
                <label class="form-label" for="telegram-api">Адрес Bot API</label>
                <input class="form-control" id="telegram-api" name="api_url" type="url" placeholder="{{ telegram.default_api }}" value="{{ telegram.api_url != telegram.default_api ? telegram.api_url : '' }}">
            </div>
            <div class="form-row">
                <label class="form-label" for="telegram-chat">Чат для проверки и служебных сообщений</label>
                <input class="form-control" id="telegram-chat" name="admin_chat" type="text" placeholder="-1001234567890" value="{{ telegram.admin_chat }}">
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        {% if telegram.token %}
            <div class="form-actions">
                <form method="post" action="{{ path('admin_integrations_telegram_test') }}" class="inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                    <button type="submit" class="btn btn--ghost btn--small">Проверить связь</button>
                </form>
                <form method="post" action="{{ path('admin_integrations_telegram_poll') }}" class="inline-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                    <button type="submit" class="btn btn--ghost btn--small">Разобрать сообщения бота</button>
                </form>
            </div>
        {% endif %}
    </div>
    <div class="card card--info">
        <h2 class="h-section">Как это работает у сотрудника</h2>
        <p>Сотрудник открывает «Профиль → Подписки и уведомления», получает одноразовый код и отправляет его боту. Портал привязывает чат к учётной записи; команда <code>/stop</code> в чате отключает уведомления.</p>
        <p>Сообщения бота разбирает команда <code>docportal telegram</code> (<code>php bin/console app:telegram:poll</code>) — поставьте её в cron раз в минуту. Кнопка «Разобрать сообщения бота» делает то же самое вручную.</p>
        <dl class="meta meta--stack">
            <div><dt>Привязанных чатов</dt><dd>{{ telegram.linked }}</dd></div>
            <div><dt>Адрес Bot API</dt><dd>{{ telegram.api_url }}</dd></div>
        </dl>
    </div>
</div>

<div class="grid grid--two" id="push">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Уведомления в браузере</h2>
            {% if push.ready %}<span class="badge badge--done"><span class="badge__dot"></span>Включены</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключены</span>{% endif %}</div>
        <p>Уведомления на экране компьютера или телефона — даже когда портал не открыт: о назначенных ознакомлениях и напоминаниях, новых редакциях документов из подписок, ответах в обсуждении, модерации и разделе «Видео» (те же события, что в Telegram). Сотрудник включает их сам на каждом своём устройстве.</p>
        {% if not push.https %}<div class="alert alert--warning">Портал открыт не по https — браузеры разрешают уведомления только на защищённых сайтах.</div>{% endif %}
        <form method="post" action="{{ path('admin_integrations_push') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ push.enabled ? 'checked' }}><span>Отправлять уведомления в браузер</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="push-subject">Контакт администратора для служб уведомлений</label>
                <input class="form-control" id="push-subject" name="subject" type="text" placeholder="admin@example.ru" value="{{ push.subject }}">
                <div class="form-help">Необязательно: адрес почты или https-адрес — службы уведомлений браузеров пишут по нему при проблемах с доставкой. Пусто — адрес отправителя писем портала.</div>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="hide_text" value="1" {{ push.hide_text ? 'checked' }}><span>Не показывать текст уведомлений</span></label>
                <div class="form-help">Для общих компьютеров: на экране — только «Новое уведомление портала», подробности — на портале после входа. Устройство отключается от уведомлений при выходе из портала, но не при простом закрытии браузера.</div>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        {% if push.public_key %}
        <form method="post" action="{{ path('admin_integrations_push_reset') }}" class="form-actions" data-confirm="Заменить ключи? Все подписки устройств будут удалены — сотрудникам придётся включить уведомления заново.">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <button type="submit" class="btn btn--ghost btn--small">Заменить ключи</button>
        </form>
        {% endif %}
    </div>
    <div class="card card--info">
        <h2 class="h-section">Что нужно для работы</h2>
        <p>Уведомление доставляет служба уведомлений браузера (Google — Chrome, Яндекс Браузер, Edge на Android; Mozilla — Firefox; Apple — Safari; Microsoft — Edge на Windows): серверу портала нужен исходящий доступ по https к её адресам. Без доступа в интернет уведомления не работают — пользуйтесь письмами и Telegram через внутренний Bot API Server.</p>
        <p>На iPhone и iPad уведомления приходят, когда портал добавлен на экран «Домой» (iOS 16.4 и новее).</p>
        <dl class="meta meta--stack">
            <div><dt>Устройств с уведомлениями</dt><dd>{{ push.devices }} (сотрудников: {{ push.users }})</dd></div>
            <div><dt>Адреса служб</dt><dd>{{ push.services|join(', ') }}</dd></div>
            {% if push.public_key %}<div><dt>Открытый ключ (VAPID)</dt><dd><code class="break-all">{{ push.public_key }}</code></dd></div>{% endif %}
        </dl>
    </div>
</div>

<div class="grid grid--two" id="llm">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Языковая модель (LLM): описания и ответы</h2>
            {% if llm.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>Включено</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключено</span>{% endif %}</div>
        <p>Портал может формировать краткие описания документов через внешнюю языковую модель по OpenAI-совместимому API (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, LocalAI и др.). Модель получает название, раздел, теги, имя файла и начало текста документа.</p>
        <form method="post" action="{{ path('admin_integrations_llm') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ llm.enabled ? 'checked' }}><span>Включить описание через LLM</span></label>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="auto_describe" value="1" {{ llm.auto_describe ? 'checked' }}><span>Автоматически описывать новые документы (при создании и импорте), если описание не заполнено</span></label>
            </div>
            <p class="form-help">Ответы на вопросы сотрудников (помощник, страница поиска, Telegram) настраиваются ниже, в блоке «Помощник».</p>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="llm-base-url">Адрес API</label>
                    <input class="form-control" id="llm-base-url" name="base_url" type="url" value="{{ llm.base_url }}" placeholder="https://api.openai.com/v1">
                    <div class="form-help">Запрос идёт на <code>&lt;адрес&gt;/chat/completions</code>. Ollama: <code>http://host:11434/v1</code>.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="llm-model">Модель</label>
                    <input class="form-control" id="llm-model" name="model" value="{{ llm.model }}" placeholder="gpt-4o-mini" required>
                </div>
                <div class="form-row">
                    <label class="form-label" for="llm-api-key">Ключ API</label>
                    <input class="form-control" id="llm-api-key" name="api_key" type="password" autocomplete="new-password" placeholder="{{ llm.api_key ? 'сохранён (' ~ llm.api_key_masked ~ ') — введите новый, чтобы заменить' : 'не задан (для локальных серверов не нужен)' }}">
                    {% if llm.api_key %}<div class="form-help"><label class="form-check form-check--inline"><input type="checkbox" name="clear_api_key" value="1"><span>удалить сохранённый ключ</span></label></div>{% endif %}
                </div>
                <div class="form-row">
                    <label class="form-label" for="llm-max-chars">Передавать текста, символов</label>
                    <input class="form-control" id="llm-max-chars" name="max_input_chars" type="number" min="500" max="400000" step="500" value="{{ llm.max_input_chars }}">
                    <div class="form-help">Начало текста документа, которое видит модель (≈ {{ (llm.max_input_chars / 3.5)|round }} токенов).</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="llm-timeout">Тайм-аут, с</label>
                    <input class="form-control" id="llm-timeout" name="timeout" type="number" min="5" max="600" value="{{ llm.timeout }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="llm-temperature">Температура</label>
                    <input class="form-control" id="llm-temperature" name="temperature" type="number" min="0" max="2" step="0.1" value="{{ llm.temperature }}">
                </div>
            </div>
            <div class="form-row">
                <label class="form-label" for="llm-prompt">Инструкция для модели (системный промпт)</label>
                <textarea class="form-control" id="llm-prompt" name="prompt" rows="5">{{ llm.prompt }}</textarea>
                <div class="form-help">{% if llm.is_default_prompt %}Используется инструкция по умолчанию.{% else %}Инструкция изменена; очистите поле, чтобы вернуть вариант по умолчанию.{% endif %}</div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
        <div class="form-actions">
            <form method="post" action="{{ path('admin_integrations_llm_test') }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <button type="submit" class="btn btn--ghost btn--small" {{ not llm.enabled ? 'disabled' }}>Проверить подключение</button>
            </form>
            <form method="post" action="{{ path('admin_integrations_llm_describe') }}" class="inline-form" data-confirm="Сформировать описания для документов без описания (до {{ describe_limit }} за раз)? Это займёт до минуты.">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <button type="submit" class="btn btn--ghost btn--small" {{ not llm.enabled or descriptions.without == 0 ? 'disabled' }}>Описать документы без описания (до {{ describe_limit }})</button>
            </form>
        </div>
    </div>
    <div class="card">
        <h2 class="h-section">Описания документов</h2>
        <div class="grid grid--stats grid--stats-compact">
            <div class="stat"><div class="stat__label">Без описания</div><div class="stat__value {{ descriptions.without > 0 ? 'text-warning' }}">{{ descriptions.without }}</div></div>
            <div class="stat"><div class="stat__label">Сформировано LLM</div><div class="stat__value">{{ descriptions.llm }}</div></div>
            <div class="stat"><div class="stat__label">Написано вручную</div><div class="stat__value">{{ descriptions.with_description - descriptions.llm }}</div></div>
        </div>
        <p class="form-help">Без учёта архива. Сгенерированное описание помечается в карточке документа значком «ИИ»; если модератор отредактирует его, пометка снимается и модель такое описание больше не трогает.</p>
        <h3 class="h-sub">Массовая обработка</h3>
        <p>Для всех документов без описания: <code>docportal console app:documents:describe --missing</code> (порциями по <code>--limit=50</code>; в cron добавлен ежечасный запуск). Переформировать сгенерированные ранее: <code>--regenerate</code>; переписать и ручные: <code>--force</code>. Предпросмотр без записи: <code>--dry-run</code>.</p>
        <p>При импорте из каталога есть флажок «Сформировать описания через LLM» (в консоли — <code>--describe</code>). В карточке документа модераторам доступна кнопка «Описать через ИИ».</p>
    </div>
</div>

<div class="grid grid--two" id="assistant">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Помощник: ответы на вопросы</h2>
            {% if assistant.ready %}<span class="badge badge--done"><span class="badge__dot"></span>Отвечает</span>{% elseif assistant.enabled %}<span class="badge badge--soon"><span class="badge__dot"></span>Нет модели</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>{% endif %}</div>
        <p>Кнопка «Помощник» на страницах портала, ответы на странице поиска, бот в Telegram и API помощника для внешних систем: модель отвечает по фрагментам документов, видео и прайс-листов, доступных сотруднику, со ссылками на источники. Модель — та же, что для описаний, или своя на другом сервере: например, на сервере с видеокартой (Ollama, vLLM) или в облачном сервисе с OpenAI-совместимым API.</p>
        <form method="post" action="{{ path('admin_integrations_assistant') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ assistant.enabled ? 'checked' }}><span>Отвечать на вопросы сотрудников</span></label>
            </div>
            <div class="form-row choice-list">
                <label class="form-check form-check--radio"><input type="radio" name="source" value="shared" {{ not assistant.own ? 'checked' }}><span><b>Та же модель, что для описаний</b><br><span class="text-muted">{{ llm.model }} · {{ llm.base_url }}{% if not llm.enabled %} — сейчас выключена{% endif %}</span></span></label>
                <label class="form-check form-check--radio"><input type="radio" name="source" value="own" {{ assistant.own ? 'checked' }}><span><b>Отдельный сервер модели</b><br><span class="text-muted">свой адрес, модель и ключ — описания документов продолжают работать как настроены выше</span></span></label>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="assistant-base-url">Адрес API</label>
                    <input class="form-control" id="assistant-base-url" name="base_url" type="url" value="{{ assistant.own_base_url }}" placeholder="http://gpu-server:11435/v1">
                    <div class="form-help">Запрос идёт на <code>&lt;адрес&gt;/chat/completions</code>. Сервер, подготовленный скриптом <code>ai-server.sh</code>: <code>http://сервер:11435/v1</code>.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="assistant-model">Модель</label>
                    <input class="form-control" id="assistant-model" name="model" value="{{ assistant.own_model }}" placeholder="qwen2.5:14b">
                </div>
                <div class="form-row">
                    <label class="form-label" for="assistant-api-key">Ключ API</label>
                    <input class="form-control" id="assistant-api-key" name="api_key" type="password" autocomplete="new-password" placeholder="{{ assistant.own_api_key ? 'сохранён (' ~ assistant.api_key_masked ~ ') — введите новый, чтобы заменить' : 'не задан' }}">
                    {% if assistant.own_api_key %}<div class="form-help"><label class="form-check form-check--inline"><input type="checkbox" name="clear_api_key" value="1"><span>удалить сохранённый ключ</span></label></div>{% endif %}
                </div>
                <div class="form-row">
                    <label class="form-label" for="assistant-timeout">Ожидание ответа, с</label>
                    <input class="form-control" id="assistant-timeout" name="timeout" type="number" min="5" max="900" value="{{ assistant.own_timeout }}">
                    <div class="form-help">На процессоре без видеокарты ответ может идти минуту и дольше.</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
        <div class="form-actions">
            <form method="post" action="{{ path('admin_integrations_assistant_test') }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <button type="submit" class="btn btn--ghost btn--small">Проверить подключение</button>
            </form>
        </div>
    </div>
    <div class="card card--info">
        <h2 class="h-section">Модель на своём сервере</h2>
        <p><b>На сервере портала:</b> <code>sudo docportal ai enable</code> — ставит Ollama, скачивает модель по объёму памяти и включает помощника.</p>
        <p><b>На отдельном сервере</b> (лучше — с видеокартой): скопируйте на него <code>deploy/ai-server.sh</code> из дистрибутива и выполните <code>sudo bash ai-server.sh --allow IP_портала</code>. Скрипт поставит Ollama и модели, закроет вход ключом и откроет порт только для портала, а в конце выведет команду для сервера портала: <code>sudo docportal ai connect --url http://сервер:11435/v1 --api-key … --model … --assistant-only</code> (или впишите адрес и ключ здесь).</p>
        <p><b>Облачный сервис</b> с OpenAI-совместимым API — адрес, модель и ключ из его кабинета.</p>
        <p><b>Внешний чат-бот</b> (корпоративный мессенджер, сайт): <code>POST {{ api_base }}/assistant</code> с ключом API «с внутренними документами» и логином сотрудника — помощник ответит по его правам (см. РУКОВОДСТВО).</p>
    </div>
</div>

{% set st = semantic_status %}
<div class="grid grid--two" id="semantic">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Поиск по смыслу (эмбеддинги)</h2>
            {% if embeddings.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>Включён</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>{% endif %}</div>
        <p>Ответы ИИ находят документы не только по словам вопроса, но и по смыслу: на «что делать при возгорании?» найдётся «Инструкция по пожарной безопасности».
            Модель эмбеддингов превращает фрагменты документов и вопрос в векторы; векторы хранятся в базе портала — отдельная векторная база не нужна.
            На странице поиска появляется и блок «Похоже по смыслу».</p>
        <form method="post" action="{{ path('admin_integrations_semantic') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ embeddings.enabled ? 'checked' }}><span>Включить поиск по смыслу</span></label>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="emb-model">Модель эмбеддингов</label>
                    <input class="form-control" id="emb-model" name="model" value="{{ embeddings.model }}" placeholder="text-embedding-3-small" required>
                    <div class="form-help">OpenAI: <code>text-embedding-3-small</code>; Ollama: <code>bge-m3</code> или <code>nomic-embed-text</code> (сначала <code>ollama pull</code>).</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-dims">Длина вектора</label>
                    <input class="form-control" id="emb-dims" name="dimensions" type="number" min="0" max="4096" value="{{ embeddings.dimensions }}">
                    <div class="form-help">0 — как у модели. Для text-embedding-3 можно 512: индекс втрое меньше, качество почти то же.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-url">Адрес API</label>
                    <input class="form-control" id="emb-url" name="base_url" type="url" value="{{ embeddings.own_base_url }}" placeholder="тот же, что у языковой модели: {{ llm.base_url }}">
                    <div class="form-help">Запрос идёт на <code>&lt;адрес&gt;/embeddings</code>.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-key">Ключ API</label>
                    <input class="form-control" id="emb-key" name="api_key" type="password" autocomplete="new-password" placeholder="{{ embeddings.own_api_key ? 'сохранён (' ~ embeddings.api_key_masked ~ ') — введите новый, чтобы заменить' : (embeddings.own_base_url ? 'не задан' : 'тот же, что у языковой модели') }}">
                    {% if embeddings.own_api_key %}<div class="form-help"><label class="form-check form-check--inline"><input type="checkbox" name="clear_api_key" value="1"><span>удалить сохранённый ключ</span></label></div>{% endif %}
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-min">Минимальное сходство</label>
                    <input class="form-control" id="emb-min" name="min_score" type="number" min="0" max="0.99" step="0.01" value="{{ embeddings.min_score }}">
                    <div class="form-help">0–1: ниже — документ не считается найденным по смыслу. Для OpenAI обычно 0,25–0,3, для bge-m3 и nomic-embed-text — 0,45–0,5. Подбирайте по «Вопросам к ИИ».</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-verified">Сходство для проверенных ответов</label>
                    <input class="form-control" id="emb-verified" name="verified_min" type="number" min="0.5" max="0.99" step="0.01" value="{{ embeddings.verified_min }}">
                    <div class="form-help">Вопрос другими словами («при возгорании» вместо «при пожаре») получает проверенный ответ, если сходство не ниже этого. Для OpenAI text-embedding-3 обычно 0,7–0,75, для bge-m3 — 0,85. Сходство показывает «Вопросы к ИИ → Проверенные ответы → Проверить вопрос».</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="emb-log">Хранить вопросы к ИИ, дней</label>
                    <input class="form-control" id="emb-log" name="log_days" type="number" min="0" max="3650" value="{{ embeddings.log_days }}">
                    <div class="form-help">Вопросы, итог и оценки ответов — для страницы «Вопросы к ИИ». 0 — не сохранять.</div>
                </div>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        <div class="form-actions">
            <form method="post" action="{{ path('admin_integrations_semantic_test') }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <button type="submit" class="btn btn--ghost btn--small">Проверить модель</button>
            </form>
            <form method="post" action="{{ path('admin_integrations_semantic_build') }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
                <button type="submit" class="btn btn--ghost btn--small" {{ not embeddings.enabled or (st and st.outdated == 0) ? 'disabled' }}>Построить индекс сейчас</button>
            </form>
        </div>
    </div>
    <div class="card">
        <h2 class="h-section">Смысловой индекс</h2>
        {% if st %}
        <div class="grid grid--stats grid--stats-compact">
            <div class="stat"><div class="stat__label">В индексе</div><div class="stat__value">{{ st.indexed }}</div><div class="stat__hint">из {{ st.published }} опубликованных</div></div>
            <div class="stat"><div class="stat__label">Ждут</div><div class="stat__value {{ st.outdated > 0 ? 'text-warning' }}">{{ st.outdated }}</div></div>
            <div class="stat"><div class="stat__label">Ошибки</div><div class="stat__value {{ st.errors > 0 ? 'text-danger' }}">{{ st.errors }}</div></div>
        </div>
        <dl class="meta meta--stack">
            {% set model_parts = st.model|split('|') %}
            <div><dt>Модель</dt><dd><code>{{ model_parts[0] }}</code>{% if (model_parts[1] ?? '0') != '0' %}, длина вектора {{ model_parts[1] }}{% endif %}{% if st.empty > 0 %}; без текста — {{ st.empty }} док.{% endif %}</dd></div>
            <div><dt>Фрагментов</dt><dd>{{ st.chunks }} ({{ (st.bytes / 1048576)|number_format(1, ',') }} МБ векторов)</dd></div>
            {% if st.last_error %}<div><dt>Последняя ошибка</dt><dd class="text-danger">{{ st.last_error }}</dd></div>{% endif %}
        </dl>
        {% else %}
        <p class="text-muted">Состояние индекса недоступно.</p>
        {% endif %}
        <p class="form-help">Индекс обновляет задание cron раз в час (<code>docportal ai-index</code>, «Мониторинг» — «Смысловой индекс для ИИ»): новые и изменившиеся опубликованные документы, после распознавания текста и при смене модели. Документ — до 60 фрагментов по тысяче символов.</p>
        <h3 class="h-sub">Вопросы к ИИ за 30 дней</h3>
        <p>Вопросов: {{ ai_stats.total }}, без ответа: {{ ai_stats.not_found + ai_stats.no_sources }}, оценки «помог / не помог»: {{ ai_stats.helpful }} / {{ ai_stats.unhelpful }}.
            <a href="{{ path('admin_ai_questions') }}">Вопросы к ИИ →</a> — на что в документах нет ответа и какие ответы не помогли.</p>
    </div>
</div>

<div class="grid grid--two" id="onlyoffice">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Редактор документов (ONLYOFFICE / Р7-Офис)</h2>
            {% if onlyoffice.enabled and onlyoffice.url and onlyoffice.secret %}<span class="badge badge--done"><span class="badge__dot"></span>Подключён</span>{% elseif onlyoffice.enabled %}<span class="badge badge--overdue"><span class="badge__dot"></span>Не настроен</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>{% endif %}</div>
        {% if app.request.secure and onlyoffice.url starts with 'http://' %}
            <div class="alert alert--warning">Портал открыт по HTTPS, а сервер документов указан с http:// — браузеры не загрузят редактор со страницы HTTPS. Нужен адрес сервера документов с https://.</div>
        {% endif %}
        <p>Правка файлов Word, Excel и PowerPoint прямо в браузере, в том числе вместе. Когда все закрыли редактор, портал сохраняет файл новой версией документа (при обязательном согласовании — редакцией, ждущей решения). Нужен установленный в компании ONLYOFFICE Docs или «Р7-Офис. Сервер документов».</p>
        <form method="post" action="{{ path('admin_integrations_onlyoffice') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ onlyoffice.enabled ? 'checked' }}><span>Включить редактирование онлайн</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="oo-url">Адрес сервера документов</label>
                <input class="form-control" id="oo-url" name="url" type="url" placeholder="https://office.example.local" value="{{ onlyoffice.url }}">
                <div class="form-help">Адрес, по которому сервер документов открывается в браузерах сотрудников: с него загружается редактор.</div>
            </div>
            <div class="form-row">
                <label class="form-label" for="oo-secret">Секрет JWT (обязательно)</label>
                <input class="form-control" id="oo-secret" name="secret" type="password" autocomplete="new-password" placeholder="{{ onlyoffice.secret ? 'сохранён (' ~ onlyoffice.secret_masked ~ ') — введите новый, чтобы заменить' : 'не задан' }}">
                <div class="form-help">Тот же, что на сервере документов (<code>services.CoAuthoring.secret</code> в local.json; в Docker — переменная <code>JWT_SECRET</code>).{% if onlyoffice.secret %} <label class="form-check form-check--inline"><input type="checkbox" name="clear_secret" value="1"><span>удалить секрет</span></label>{% endif %}</div>
            </div>
            <details class="form-row">
                <summary>Дополнительно: внутренние адреса, заголовок токена</summary>
                <div class="form-row">
                    <label class="form-label" for="oo-internal">Внутренний адрес сервера документов</label>
                    <input class="form-control" id="oo-internal" name="internal_url" type="url" placeholder="http://onlyoffice:80" value="{{ onlyoffice.internal_url }}">
                    <div class="form-help">Если сервер портала обращается к серверу документов не по внешнему адресу (другая сеть, Docker). Пусто — внешний адрес.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="oo-portal">Адрес портала для сервера документов</label>
                    <input class="form-control" id="oo-portal" name="portal_url" type="url" placeholder="http://10.0.0.5" value="{{ onlyoffice.portal_url }}">
                    <div class="form-help">По нему сервер документов скачивает файлы и присылает уведомления о сохранении (без пути, только схема, имя и порт). Пусто — обычный адрес портала.</div>
                </div>
                <div class="form-row">
                    <label class="form-label" for="oo-header">Заголовок с токеном</label>
                    <input class="form-control form-control--inline" id="oo-header" name="header" type="text" placeholder="Authorization" value="{{ onlyoffice.header != 'Authorization' ? onlyoffice.header : '' }}">
                    <div class="form-help">Если на сервере документов изменён <code>services.CoAuthoring.token.inbox.header</code>. Обычно не меняется.</div>
                </div>
            </details>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="view" value="1" {{ onlyoffice.view ? 'checked' }}><span>Открывать офисные файлы в редакторе и для просмотра <span class="hints">— кнопка «Открыть в редакторе» у всех, кто видит документ</span></span></label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
        {% if onlyoffice.url %}
        <form method="post" action="{{ path('admin_integrations_onlyoffice_test') }}" class="form-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('integrations') }}">
            <button type="submit" class="btn btn--ghost btn--small">Проверить соединение</button>
        </form>
        {% endif %}
    </div>
    <div class="card card--info">
        <h2 class="h-section">Как это работает</h2>
        <p><b>Правка.</b> Модератор раздела нажимает в карточке документа «Редактировать онлайн». Открывается последняя редакция; несколько человек могут править её одновременно. Новая версия появляется в портале примерно через 10 секунд после того, как последний участник закрыл редактор, — с отметкой «Изменено в редакторе онлайн».</p>
        <p><b>Форматы.</b> Правятся: {{ onlyoffice.editable|map(e => e|upper)|join(', ') }}. Только просмотр: {{ onlyoffice.view_only|map(e => e|upper)|join(', ') }}.</p>
        <p><b>Сеть.</b> Браузеры сотрудников должны открывать адрес сервера документов, а сервер документов — адрес портала (для файлов и уведомлений, например <code>{{ onlyoffice.callback_example|split('/onlyoffice/')|first }}/onlyoffice/…</code>). Ссылки для сервера документов подписаны отдельным ключом портала (файл — сутки, уведомления — неделю); изменённый файл скачивается только с сервера документов.</p>
        <p><b>Безопасность.</b> На сервере документов должен быть включён JWT (по умолчанию включён в ONLYOFFICE Docs 7.2+), здесь — тот же секрет: им подписывается редактор и проверяется каждое уведомление о сохранении. Без секрета редактирование не включается. Выключение интеграции, смена адреса или секрета сразу отзывают все выданные ссылки; редактор доступен только сотрудникам, вошедшим в портал.</p>
    </div>
</div>
{% endblock %}
