{% extends 'admin/_layout.html.twig' %}

{% block title %}Настройки{% endblock %}
{% block admin_title %}Настройки{% endblock %}

{% block admin_body %}
<div class="grid grid--two">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Просмотр без входа</h2>
            {% if guest.mode == 'off' %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>
            {% elseif guest.mode == 'ip' %}<span class="badge badge--soon"><span class="badge__dot"></span>Только с указанных адресов</span>
            {% else %}<span class="badge badge--done"><span class="badge__dot"></span>Разрешён отовсюду</span>{% endif %}</div>
        <p>Гости (без входа в портал) видят дерево разделов и <b>открытые</b> опубликованные документы. Внутренние документы, черновики и архив доступны только после входа. Здесь можно ограничить просмотр без входа адресами корпоративной сети или выключить его совсем.</p>
        <form method="post" action="{{ path('admin_settings_guest_access') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <div class="form-row">
                <span class="form-label">Режим</span>
                <div class="choice-list">
                    {% for value, label in guest.modes %}
                        <label class="form-check form-check--radio"><input type="radio" name="mode" value="{{ value }}" {{ guest.mode == value ? 'checked' }}><span>{{ label|slice(0, 1)|upper }}{{ label|slice(1) }}</span></label>
                    {% endfor %}
                </div>
            </div>
            <div class="form-row">
                <label class="form-label" for="guest-networks">Разрешённые IP-адреса и подсети</label>
                <textarea class="form-control" id="guest-networks" name="networks" rows="5" placeholder="192.168.10.0/24&#10;10.0.0.0/8&#10;172.16.5.20">{{ guest.networks|join("\n") }}</textarea>
                <div class="form-help">По одному адресу или подсети (CIDR) в строке; поддерживаются IPv4 и IPv6. Используются в режиме «только с указанных IP-адресов и подсетей». Ваш текущий адрес: <code>{{ guest.client_ip }}</code>{% if guest.mode == 'ip' %} — {{ guest.client_allowed ? 'входит в список' : 'НЕ входит в список' }}{% endif %}. Если портал стоит за прокси, укажите его в <code>TRUSTED_PROXIES</code>, иначе все посетители будут видны с адреса прокси.</div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
    </div>
    <div class="card card--info">
        <h2 class="h-section">Как это работает</h2>
        <p>Открытый документ — флажок «Открытый документ» в карточке (включён по умолчанию для всех документов, в том числе импортированных). Снимите его у документов только для сотрудников — они станут <b>внутренними</b> и будут показываться только после входа.</p>
        <p>Гость, которому просмотр без входа не разрешён (выключен или адрес вне списка), при открытии любой страницы попадает на форму входа. Вход по логину и паролю, панель администратора, работа модераторов и внутренние документы от режима не зависят.</p>
        <p>Просмотры и скачивания гостей учитываются в статистике под именем «Гость». Остальные параметры ниже задаются в файле <code>.env.local</code> на сервере (или в <code>docker/.env</code>); после их изменения выполните <code>docportal console cache:clear</code>.</p>
    </div>
</div>
<div class="grid grid--two">
    <div class="card">
        <div class="card__head"><h2 class="h-section">Active Directory / LDAP</h2>
            {% if ldap.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>Включён</span>{% else %}<span class="badge badge--none"><span class="badge__dot"></span>Выключен</span>{% endif %}</div>
        <dl class="meta meta--stack">
            <div><dt>Расширение PHP ldap</dt><dd>{{ php.ldap_ext ? 'установлено' : 'не установлено' }}</dd></div>
            <div><dt>Сервер</dt><dd>{{ ldap.host }}:{{ ldap.port }} ({{ ldap.encryption }})</dd></div>
            <div><dt>База поиска</dt><dd><code>{{ ldap.base_dn }}</code></dd></div>
            <div><dt>Служебная учётная запись</dt><dd>{{ ldap.bind_dn ?: 'не задана (привязка от имени пользователя, суффикс ' ~ ldap.upn_suffix ~ ')' }}</dd></div>
            <div><dt>Фильтр</dt><dd><code>{{ ldap.filter }}</code> (атрибут логина: {{ ldap.uid_key }})</dd></div>
            <div><dt>Атрибуты</dt><dd>имя — {{ ldap.name_attr }}, почта — {{ ldap.mail_attr }}</dd></div>
            <div><dt>Группа администраторов</dt><dd>{{ ldap.admin_group ?: '—' }}</dd></div>
            <div><dt>Группа доступа</dt><dd>{{ ldap.user_group ?: 'все пользователи домена' }}</dd></div>
        </dl>
        <form method="post" action="{{ path('admin_settings_ldap_test') }}" class="form-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <button type="submit" class="btn btn--ghost btn--small">Проверить подключение</button>
        </form>
    </div>
    <div class="card">
        <div class="card__head"><h2 class="h-section">Почта и уведомления</h2>
            {% if mail.dsn_set %}<span class="badge badge--done"><span class="badge__dot"></span>Отправка настроена</span>{% else %}<span class="badge badge--soon"><span class="badge__dot"></span>Только журнал</span>{% endif %}</div>
        <dl class="meta meta--stack">
            <div><dt>Отправитель</dt><dd>{{ mail.from }}</dd></div>
            <div><dt>Копия администраторам</dt><dd>{{ mail.notify_admins ? 'да' : 'нет' }}</dd></div>
            <div><dt>Окно «истекает»</dt><dd>{{ validity.soon_days }} дн. до даты «Актуален до»</dd></div>
            <div><dt>Срок по умолчанию для новых документов</dt><dd>{{ validity.default_months > 0 ? validity.default_months ~ ' мес.' : 'не задан' }}</dd></div>
            <div><dt>Часовой пояс</dt><dd>{{ validity.timezone }}</dd></div>
        </dl>
        <div class="form-actions">
            <form method="post" action="{{ path('admin_settings_mail_test') }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <button type="submit" class="btn btn--ghost btn--small">Отправить тестовое письмо себе</button>
            </form>
            <form method="post" action="{{ path('admin_settings_expiry_run') }}" class="inline-form" data-confirm="Запустить проверку сроков и разослать уведомления сейчас?">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <button type="submit" class="btn btn--ghost btn--small">Проверить сроки сейчас</button>
            </form>
        </div>
        <p class="form-help">Ежедневная проверка выполняется командой <code>app:documents:expiry</code> по cron (настраивается скриптом установки).</p>
    </div>
</div>
<div class="grid grid--two">
    <div class="card">
        <h2 class="h-section">Хранилище файлов</h2>
        <dl class="meta meta--stack">
            <div><dt>Каталог</dt><dd><code>{{ storage.dir }}</code> — {{ storage.writable ? 'доступен для записи' : 'НЕДОСТУПЕН для записи' }}</dd></div>
            <div><dt>Лимит размера файла</dt><dd>{{ storage.max_mb }} МБ (PHP: upload_max_filesize {{ storage.php_upload_max }}, post_max_size {{ storage.php_post_max }})</dd></div>
            <div><dt>Разрешённые форматы</dt><dd>{{ storage.extensions|join(', ') }}</dd></div>
            <div><dt>Каталог импорта</dt><dd><code>{{ storage.import_dir }}</code> — {{ storage.import_writable ? 'доступен для записи' : 'не создан или недоступен для записи' }} · <a href="{{ path('admin_import') }}">Импорт из каталога</a></dd></div>
        </dl>
    </div>
    <div class="card">
        <div class="card__head"><h2 class="h-section">Полнотекстовый поиск</h2>
            {% if search.pending > 0 %}<span class="badge badge--soon"><span class="badge__dot"></span>ожидают индексации: {{ search.pending }}</span>
            {% else %}<span class="badge badge--done"><span class="badge__dot"></span>индекс актуален</span>{% endif %}</div>
        <dl class="meta meta--stack">
            <div><dt>Проиндексировано</dt><dd>{{ search.indexed }} из {{ search.documents }} документов, с текстом — {{ search.with_text }}</dd></div>
            <div><dt>Объём текста в индексе</dt><dd>{{ (search.chars / 1000)|round }} тыс. символов</dd></div>
            <div><dt>Форматы</dt><dd>страницы, {{ search.extensions|join(', ') }}{% if not search.pdf %} <span class="text-danger">(PDF недоступен — нет pdftotext, пакет poppler-utils)</span>{% endif %}</dd></div>
        </dl>
        <form method="post" action="{{ path('admin_settings_reindex') }}" class="form-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <button type="submit" class="btn btn--ghost btn--small">Проиндексировать изменившиеся</button>
            <button type="submit" name="all" value="1" class="btn btn--ghost btn--small" formnovalidate>Переиндексировать всё</button>
        </form>
        <p class="form-help">Индекс обновляется автоматически при загрузке версий; по cron раз в час выполняется <code>app:documents:describe</code> и <code>app:search:reindex</code> для документов, которые остались без индекса (например, после восстановления из резервной копии).</p>
    </div>
    <div class="card">
        <div class="card__head"><h2 class="h-section">Согласование документов</h2>
            {% if approval.required %}<span class="badge badge--done"><span class="badge__dot"></span>включено</span>
            {% else %}<span class="badge"><span class="badge__dot"></span>выключено</span>{% endif %}</div>
        <form method="post" action="{{ path('admin_settings_approval') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="required" value="1" {{ approval.required ? 'checked' }}><span>Публиковать документы только после согласования</span></label>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="auto_publish" value="1" {{ approval.auto_publish ? 'checked' }}><span>Публиковать документ сразу после согласования</span></label>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        <p class="form-help">Модератор отправляет черновик согласующему («Отправить на согласование» в карточке документа), тот согласует или отклоняет с комментарием. Решение относится к редакции: после новой версии согласование запрашивается заново. Импорт из каталога и консольные команды это правило не проверяют.</p>
    </div>
    <div class="card">
        <div class="card__head"><h2 class="h-section">Предпросмотр офисных файлов</h2>
            {% if preview.available %}<span class="badge badge--done"><span class="badge__dot"></span>доступен</span>
            {% else %}<span class="badge badge--soon"><span class="badge__dot"></span>нет LibreOffice</span>{% endif %}</div>
        {% if preview.available %}
            <dl class="meta meta--stack">
                <div><dt>Программа</dt><dd><code>{{ preview.binary }}</code></dd></div>
                <div><dt>Форматы</dt><dd>{{ preview.extensions|join(', ') }}</dd></div>
                <div><dt>Готовых предпросмотров</dt><dd>{{ preview.files }} ({{ preview.bytes|filesize }})</dd></div>
            </dl>
            <form method="post" action="{{ path('admin_settings_preview_clear') }}" class="form-actions">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <button type="submit" class="btn btn--ghost btn--small">Очистить кэш предпросмотра</button>
            </form>
            <p class="form-help">Файл Word, Excel или PowerPoint открывается прямо в браузере: портал переводит его в PDF и запоминает результат. Отдельный сервер документов не нужен.</p>
        {% else %}
            <p class="text-muted">Установите LibreOffice, чтобы сотрудники открывали файлы Word, Excel и PowerPoint прямо в браузере, не скачивая их:</p>
            <pre class="code-block">sudo apt-get install -y libreoffice-nogui</pre>
            <p class="form-help">Путь к программе можно задать переменной <code>SOFFICE_BIN</code> в <code>.env.local</code>.</p>
        {% endif %}
    </div>
    <div class="card">
        <div class="card__head"><h2 class="h-section">Распознавание сканов (OCR)</h2>
            {% if ocr.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>включено</span>
            {% elseif ocr.available %}<span class="badge"><span class="badge__dot"></span>выключено</span>
            {% else %}<span class="badge badge--soon"><span class="badge__dot"></span>нет tesseract</span>{% endif %}</div>
        {% if ocr.available %}
            <form method="post" action="{{ path('admin_settings_ocr') }}" class="form">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <div class="form-row form-row--check">
                    <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ ocr.enabled ? 'checked' }}><span>Распознавать текст на сканах и в изображениях</span></label>
                </div>
                <div class="form-row">
                    <label class="form-label" for="ocr-languages">Языки</label>
                    <input class="form-control" id="ocr-languages" type="text" name="languages" value="{{ ocr.languages }}" placeholder="rus+eng">
                    <div class="form-help">Установлены: {{ ocr.installed|join(', ') ?: 'нет данных' }}. Недостающий язык ставится пакетом <code>tesseract-ocr-rus</code>.</div>
                </div>
                <div class="form-grid">
                    <div class="form-row">
                        <label class="form-label" for="ocr-pages">Страниц на документ</label>
                        <input class="form-control" id="ocr-pages" type="number" name="max_pages" min="1" max="200" value="{{ ocr.max_pages }}">
                    </div>
                    <div class="form-row">
                        <label class="form-label" for="ocr-dpi">Разрешение, dpi</label>
                        <input class="form-control" id="ocr-dpi" type="number" name="dpi" min="72" max="600" step="50" value="{{ ocr.dpi }}">
                    </div>
                </div>
                <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
            </form>
            <p class="form-help">Распознавание выполняется при индексации (по cron), а не при открытии документа: страница скана обрабатывается несколько секунд. Текстовый слой, если он есть, всегда берётся из файла — распознавание включается только для сканов.</p>
        {% else %}
            <p class="text-muted">Сканы (PDF без текстового слоя и фотографии документов) не попадают в поиск. Чтобы это исправить, установите:</p>
            <pre class="code-block">sudo apt-get install -y tesseract-ocr tesseract-ocr-rus poppler-utils</pre>
        {% endif %}
    </div>
    <div class="card">
        <h2 class="h-section">Система</h2>
        <dl class="meta meta--stack">
            <div><dt>Версия портала</dt><dd>{{ app_version }}</dd></div>
            <div><dt>PHP</dt><dd>{{ php.version }}, memory_limit {{ php.memory_limit }}</dd></div>
            <div><dt>Диагностика</dt><dd><code>docportal status</code> на сервере или <code>php bin/console app:check</code></dd></div>
        </dl>
    </div>
</div>
{% endblock %}
