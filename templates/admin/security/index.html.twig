{% extends 'admin/_layout.html.twig' %}

{% block title %}Вход и безопасность{% endblock %}
{% block admin_title %}Вход и безопасность{% endblock %}

{% block admin_body %}
<div class="grid grid--two">
    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Вход через SSO (OpenID Connect)</h2>
            {% if sso.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>включён</span>
            {% else %}<span class="badge badge--none"><span class="badge__dot"></span>выключен</span>{% endif %}</div>
        <p>Единый вход через корпоративный провайдер: Keycloak, Blitz Identity Provider, AD FS, Authentik и другие,
            поддерживающие OpenID Connect. Портал использует поток «код авторизации» с PKCE.</p>
        <dl class="meta meta--stack">
            <div><dt>Адрес возврата (redirect URI)</dt><dd><code id="sso-redirect">{{ redirect_uri }}</code>
                <button type="button" class="btn btn--ghost btn--small" data-copy="#sso-redirect">Скопировать</button></dd></div>
        </dl>
        <form method="post" action="{{ path('admin_security_sso') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ sso.enabled ? 'checked' }}><span>Разрешить вход через SSO</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="sso-issuer">Адрес провайдера (issuer)</label>
                <input class="form-control" id="sso-issuer" name="issuer" type="url" value="{{ sso.issuer }}" placeholder="https://sso.example.local/realms/company">
                <div class="form-help">Портал сам запросит <code>{issuer}/.well-known/openid-configuration</code>.</div>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="sso-client">Идентификатор клиента</label>
                    <input class="form-control" id="sso-client" name="client_id" value="{{ sso.client_id }}" placeholder="docportal">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-secret">Секрет клиента</label>
                    <input class="form-control" id="sso-secret" name="client_secret" type="password" autocomplete="new-password" placeholder="{{ sso.secret_set ? 'сохранён (' ~ sso.secret_masked ~ ') — введите новый, чтобы заменить' : 'не задан' }}">
                    {% if sso.secret_set %}<div class="form-help"><label class="form-check form-check--inline"><input type="checkbox" name="clear_secret" value="1"><span>удалить секрет</span></label></div>{% endif %}
                </div>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="sso-scopes">Области (scopes)</label>
                    <input class="form-control" id="sso-scopes" name="scopes" value="{{ sso.scopes }}" placeholder="openid profile email">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-button">Надпись на кнопке</label>
                    <input class="form-control" id="sso-button" name="button" maxlength="64" value="{{ sso.button }}">
                </div>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="create_users" value="1" {{ sso.create_users ? 'checked' }}><span>Создавать учётные записи при первом входе</span></label>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="sso-username">Утверждение с логином</label>
                    <input class="form-control" id="sso-username" name="username_claim" value="{{ sso.username_claim }}" placeholder="preferred_username">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-name">Утверждение с именем</label>
                    <input class="form-control" id="sso-name" name="name_claim" value="{{ sso.name_claim }}" placeholder="name">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-email">Утверждение с почтой</label>
                    <input class="form-control" id="sso-email" name="email_claim" value="{{ sso.email_claim }}" placeholder="email">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-dept">Утверждение с подразделением</label>
                    <input class="form-control" id="sso-dept" name="department_claim" value="{{ sso.department_claim }}" placeholder="department">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-admin-claim">Утверждение с ролями</label>
                    <input class="form-control" id="sso-admin-claim" name="admin_claim" value="{{ sso.admin_claim }}" placeholder="groups">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-admin-value">Значение для администратора</label>
                    <input class="form-control" id="sso-admin-value" name="admin_value" value="{{ sso.admin_value }}" placeholder="docportal-admins">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-marketer-value">Значение для маркетолога</label>
                    <input class="form-control" id="sso-marketer-value" name="marketer_value" value="{{ sso.marketer_value|default('') }}" placeholder="marketing">
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-assistant-value">Значение для помощника маркетолога</label>
                    <input class="form-control" id="sso-assistant-value" name="assistant_value" value="{{ sso.assistant_value|default('') }}" placeholder="marketing-assistants">
                    <p class="form-help">Если задано значение для маркетолога или помощника, роль сотрудника при каждом входе через SSO берётся из утверждения с ролями (иначе роли назначаются в карточке пользователя).</p>
                </div>
                <div class="form-row">
                    <label class="form-label" for="sso-domains">Допустимые домены логинов</label>
                    <input class="form-control" id="sso-domains" name="domains" value="{{ sso.domains|default('') }}" placeholder="corp.example.ru, CORP">
                    <p class="form-help">Логины вида user@домен или ДОМЕН\user из других доменов не пускаются. Существующая учётная запись (например, из каталога) связывается с провайдером по короткому логину, только если домен в этом списке или совпала почта.</p>
                    {% if not sso.domains|default('') and sso.create_users %}<p class="form-help text-warning">Список пуст, а учётные записи создаются автоматически: если у провайдера есть гости или другие домены, гость partner\ivanov первым займёт логин ivanov. Укажите свои домены.</p>{% endif %}
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--pill btn--small">Сохранить</button>
            </div>
        </form>
        <form method="post" action="{{ path('admin_security_sso_test') }}" class="form-actions">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <button type="submit" class="btn btn--ghost btn--small">Проверить подключение</button>
        </form>
        <p class="form-help">Пока утверждение с ролями не задано, права администратора в портале назначаются вручную — провайдер их не меняет.</p>
    </div>

    <div class="card card--form" id="saml">
        <div class="card__head"><h2 class="h-section">Вход через SAML 2.0</h2>
            {% if saml.ready %}<span class="badge badge--done"><span class="badge__dot"></span>включён</span>
            {% elseif saml.enabled %}<span class="badge badge--overdue"><span class="badge__dot"></span>не настроен</span>
            {% else %}<span class="badge"><span class="badge__dot"></span>выключен</span>{% endif %}</div>
        <p class="form-help">Для провайдеров без OpenID Connect: AD FS, Shibboleth, Blitz Identity, Keycloak и др. Зарегистрируйте портал у провайдера по метаданным или вручную, затем вставьте метаданные провайдера ниже — поля заполнятся сами.</p>
        {% if not saml.base_ready %}
            <div class="alert alert--warning">Не задан адрес портала: укажите его ниже («Адрес портала для провайдера») или в параметре APP_DEFAULT_URI — по нему провайдер узнаёт портал, и с ним сверяется каждый ответ.</div>
        {% endif %}
        <dl class="meta meta--stack">
            <div><dt>Метаданные портала (entityID)</dt><dd><code id="saml-sp">{{ saml.sp_entity_id }}</code>
                <button type="button" class="btn btn--ghost btn--small" data-copy="#saml-sp">Скопировать</button></dd></div>
            <div><dt>Адрес приёма ответа (ACS, HTTP-POST)</dt><dd><code id="saml-acs">{{ saml.acs_url }}</code>
                <button type="button" class="btn btn--ghost btn--small" data-copy="#saml-acs">Скопировать</button></dd></div>
        </dl>
        <form method="post" action="{{ path('admin_security_saml_metadata') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row">
                <label class="form-label" for="saml-metadata">Метаданные провайдера</label>
                <textarea class="form-control" id="saml-metadata" name="metadata" rows="3" placeholder="https://adfs.example.local/FederationMetadata/2007-06/FederationMetadata.xml — или вставьте XML" required></textarea>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--ghost btn--small">Заполнить по метаданным</button></div>
        </form>
        <form method="post" action="{{ path('admin_security_saml') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ saml.enabled ? 'checked' }}><span>Разрешить вход через SAML</span></label>
            </div>
            <div class="form-row">
                <label class="form-label" for="saml-idp">Идентификатор провайдера (entityID)</label>
                <input class="form-control" id="saml-idp" name="idp_entity_id" value="{{ saml.idp_entity_id }}" placeholder="http://adfs.example.local/adfs/services/trust">
            </div>
            <div class="form-row">
                <label class="form-label" for="saml-sso">Адрес входа провайдера (HTTP-Redirect)</label>
                <input class="form-control" id="saml-sso" name="idp_sso_url" type="url" value="{{ saml.idp_sso_url }}" placeholder="https://adfs.example.local/adfs/ls/">
            </div>
            <div class="form-row">
                <label class="form-label" for="saml-cert">Сертификат подписи провайдера</label>
                <textarea class="form-control" id="saml-cert" name="idp_cert" rows="4" placeholder="-----BEGIN CERTIFICATE-----">{{ saml.idp_cert }}</textarea>
                <div class="form-help">PEM; на время замены сертификата у провайдера — оба, один за другим.
                    {% for c in saml.certs %}<br>{{ c.subject ?: 'сертификат' }} — действует до {{ c.valid_to|date('d.m.Y') }}{% if c.expired %} <span class="text-warning">(истёк)</span>{% endif %}{% endfor %}</div>
            </div>
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label" for="saml-button">Надпись на кнопке</label>
                    <input class="form-control" id="saml-button" name="button" maxlength="64" value="{{ saml.button }}">
                </div>
                <div class="form-row form-row--check">
                    <label class="form-check"><input type="checkbox" name="create_users" value="1" {{ saml.create_users ? 'checked' }}><span>Создавать учётные записи при первом входе</span></label>
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-base">Адрес портала для провайдера</label>
                    <input class="form-control" id="saml-base" name="sp_base_url" type="url" value="{{ saml.sp_base_url }}" placeholder="{{ saml.default_base|default('https://docs.example.ru') }}">
                    <p class="form-help">Пусто — из APP_DEFAULT_URI{% if saml.default_base %} ({{ saml.default_base }}){% endif %}. Из него строятся адреса выше.</p>
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-domains">Допустимые домены логинов</label>
                    <input class="form-control" id="saml-domains" name="domains" value="{{ saml.domains }}" placeholder="corp.example.ru, CORP">
                    <p class="form-help">Как для SSO: логины из других доменов не пускаются, существующие учётные записи связываются только при подтверждённом домене или совпавшей почте.</p>
                    {% if not saml.domains and saml.create_users %}<p class="form-help text-warning">Список пуст, а учётные записи создаются автоматически: гость другого домена первым займёт короткий логин. Укажите свои домены.</p>{% endif %}
                </div>
                <div class="form-row form-row--check">
                    <label class="form-check"><input type="checkbox" name="allow_idp_initiated" value="1" {{ saml.allow_idp_initiated ? 'checked' }}><span>Разрешить вход со стороны провайдера (из его портала приложений)</span></label>
                    <p class="form-help">Без этого принимаются только ответы на вход, начатый кнопкой на странице портала в этом же браузере. С ним ответ, полученный посторонним для себя, можно подставить в браузер коллеги — включайте, только если вход из портала провайдера действительно нужен.</p>
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-username">Атрибут с логином</label>
                    <input class="form-control" id="saml-username" name="username_attr" value="{{ saml.username_attr }}" placeholder="пусто — NameID">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-name">Атрибут с именем</label>
                    <input class="form-control" id="saml-name" name="name_attr" value="{{ saml.name_attr }}" placeholder="displayName">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-email">Атрибут с почтой</label>
                    <input class="form-control" id="saml-email" name="email_attr" value="{{ saml.email_attr }}" placeholder="mail">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-dept">Атрибут с подразделением</label>
                    <input class="form-control" id="saml-dept" name="department_attr" value="{{ saml.department_attr }}" placeholder="department">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-roles">Атрибут с группами</label>
                    <input class="form-control" id="saml-roles" name="roles_attr" value="{{ saml.roles_attr }}" placeholder="http://schemas.microsoft.com/ws/2008/06/identity/claims/role">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-admin">Группа администраторов</label>
                    <input class="form-control" id="saml-admin" name="admin_value" value="{{ saml.admin_value }}" placeholder="docportal-admins">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-marketer">Группа маркетологов</label>
                    <input class="form-control" id="saml-marketer" name="marketer_value" value="{{ saml.marketer_value }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="saml-assistant">Группа помощников маркетолога</label>
                    <input class="form-control" id="saml-assistant" name="assistant_value" value="{{ saml.assistant_value }}">
                </div>
            </div>
            <p class="form-help">Имя и почта без указанных атрибутов берутся из обычных: displayName, mail, утверждения AD FS. Пока атрибут с группами не задан, роли назначаются в карточке пользователя. Ответ провайдера должен быть подписан (ответ целиком или утверждение) и отвечать на запрос входа из этого браузера; зашифрованные утверждения не поддерживаются. Учётная запись привязывается к NameID формата persistent, при других форматах — к логину. Выход из портала не завершает сеанс у провайдера.</p>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
    </div>

    <div class="card card--form">
        <div class="card__head"><h2 class="h-section">Двухфакторная аутентификация</h2>
            {% if require_2fa_admins %}<span class="badge badge--done"><span class="badge__dot"></span>обязательна для администраторов</span>
            {% else %}<span class="badge"><span class="badge__dot"></span>по желанию</span>{% endif %}</div>
        <dl class="meta meta--stack">
            <div><dt>Включили второй фактор</dt><dd>{{ two_factor.enabled }} из {{ two_factor.active }} активных сотрудников</dd></div>
            <div><dt>Администраторы</dt><dd>{{ two_factor.admins }}, без второго фактора — {% if two_factor.admins_without > 0 %}<span class="text-warning">{{ two_factor.admins_without }}</span>{% else %}0{% endif %}</dd></div>
        </dl>
        <form method="post" action="{{ path('admin_security_two_factor') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="require_2fa_admins" value="1" {{ require_2fa_admins ? 'checked' }}><span>Требовать второй фактор от администраторов</span></label>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        <p class="form-help">Каждый сотрудник включает второй фактор сам: «Двухфакторная аутентификация» в подвале страницы.
            Портал показывает QR-код для приложения-аутентификатора и восемь резервных кодов на случай утери телефона.
            Если политика включена, администратор без второго фактора при входе попадёт на страницу настройки.</p>
    </div>

    <div class="card card--form" id="kerberos">
        <div class="card__head"><h2 class="h-section">Вход через Windows (Kerberos)</h2>
            {% if kerberos.enabled %}<span class="badge badge--done"><span class="badge__dot"></span>включён</span>
            {% else %}<span class="badge"><span class="badge__dot"></span>выключен</span>{% endif %}</div>
        <p class="form-help">Сотрудники с компьютеров в домене входят без пароля — под учётной записью Windows. Проверяет её веб-сервер:
            nginx с модулем SPNEGO (на сервере портала его настраивает команда
            <code>docportal kerberos on --keytab /путь/http.keytab --service HTTP/{{ app.request.host }}</code>)
            или прокси перед порталом (Apache с mod_auth_gssapi, IIS), который передаёт учётную запись заголовком.
            Адрес входа: <code>{{ kerberos_url }}</code>.</p>
        <form method="post" action="{{ path('admin_security_kerberos') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="enabled" value="1" {{ kerberos.enabled ? 'checked' }}><span>Разрешить вход через Windows</span></label>
            </div>
            <div class="form-row">
                <span class="form-label">Откуда портал берёт учётную запись</span>
                <div class="radio-stack">
                    <label class="form-check form-check--radio"><input type="radio" name="source" value="remote_user" {{ kerberos.source == 'remote_user' ? 'checked' }}><span>От nginx этого сервера (переменная REMOTE_USER, модуль SPNEGO)</span></label>
                    <label class="form-check form-check--radio"><input type="radio" name="source" value="header" {{ kerberos.source == 'header' ? 'checked' }}><span>Из заголовка от прокси перед порталом (Apache, IIS)</span></label>
                </div>
            </div>
            <div class="form-row">
                <label class="form-label" for="krb-header">Заголовок с учётной записью</label>
                <input class="form-control" id="krb-header" name="header" value="{{ kerberos.header }}" maxlength="64" placeholder="X-Remote-User">
            </div>
            <div class="form-row">
                <label class="form-label" for="krb-proxies">Адреса доверенных прокси</label>
                <input class="form-control" id="krb-proxies" name="trusted_proxies" value="{{ kerberos.trusted_proxies }}" placeholder="10.0.0.5, 10.0.1.0/24">
                <p class="form-help">Только для заголовка: с других адресов заголовок не принимается, иначе его мог бы подставить кто угодно.</p>
            </div>
            <div class="form-row">
                <label class="form-label" for="krb-realms">Допустимые домены (области Kerberos)</label>
                <input class="form-control" id="krb-realms" name="realms" value="{{ kerberos.realms }}" placeholder="CORP.LOCAL, CORP">
                <p class="form-help">Пусто — любые, которым доверяет веб-сервер. Учётная запись «ivanov@CORP.LOCAL» или «CORP\ivanov» становится логином «ivanov».</p>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="auto" value="1" {{ kerberos.auto ? 'checked' }}><span>Входить через Windows сразу, без нажатия кнопки (после выхода и при неудаче — форма с паролем)</span></label>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="create_users" value="1" {{ kerberos.create_users ? 'checked' }}><span>Заводить учётную запись при первом входе (данные — из Active Directory, если настроен LDAP)</span></label>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="allow_local" value="1" {{ kerberos.allow_local ? 'checked' }}><span>Пускать и в локальные учётные записи портала с тем же логином (не рекомендуется: доменный «admin» вошёл бы в локального администратора)</span></label>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        <p class="form-help">В браузерах сотрудников адрес портала должен быть в зоне «Местная интрасеть» (групповая политика
            «Список назначений зоны для веб-сайтов»); для Chrome и Edge — политика AuthServerAllowlist, для Firefox —
            network.negotiate-auth.trusted-uris. Вход через Windows проходит и двухфакторную проверку, если она включена у сотрудника.</p>
    </div>

    <div class="card card--form" id="watermark">
        <div class="card__head"><h2 class="h-section">Водяной знак на PDF</h2>
            {% if watermark.mode == 'off' %}<span class="badge"><span class="badge__dot"></span>выключен</span>
            {% elseif watermark_available %}<span class="badge badge--done"><span class="badge__dot"></span>включён</span>
            {% else %}<span class="badge badge--overdue"><span class="badge__dot"></span>нет qpdf</span>{% endif %}</div>
        <p class="form-help">При просмотре и скачивании PDF (и предпросмотре офисных файлов) поверх страниц ставится полупрозрачная
            надпись с ФИО и логином сотрудника, датой и временем, а внизу страницы — строка «Выдано: …» с адресом компьютера.
            Файл в хранилище не меняется: копия со знаком готовится для каждого скачивания.</p>
        {% if not watermark_available %}
            <div class="alert alert--warning">На сервере нет программы <code>qpdf</code>. Установите пакет: <code>apt install qpdf</code> (Debian, Ubuntu, Astra) или <code>dnf install qpdf</code> (RHEL, РЕД ОС); при обновлении портала скрипт ставит его сам. Без qpdf файлы отдаются без знака, в «Мониторинге» — предупреждение.</div>
        {% endif %}
        <form method="post" action="{{ path('admin_security_watermark') }}" class="form">
            <input type="hidden" name="_token" value="{{ csrf_token('security') }}">
            <div class="form-row">
                <label class="form-label" for="wm-mode">Ставить знак</label>
                <select class="form-control" id="wm-mode" name="mode">
                    {% for value, label in watermark_modes %}<option value="{{ value }}" {{ watermark.mode == value ? 'selected' }}>{{ label }}</option>{% endfor %}
                </select>
            </div>
            <div class="form-row">
                <label class="form-label" for="wm-text">Текст перед ФИО</label>
                <input class="form-control" id="wm-text" name="text" maxlength="60" value="{{ watermark.text }}" placeholder="Для служебного пользования">
                <p class="form-help">Необязательно. Например, «Для служебного пользования» или «Копия, не подлежит распространению».</p>
            </div>
            <div class="form-row form-row--check">
                <label class="form-check"><input type="checkbox" name="skip_editors" value="1" {{ watermark.skip_editors ? 'checked' }}><span>Не ставить знак тем, кто может править документ (модераторы раздела, администраторы) — им нужен чистый файл для новой редакции</span></label>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn--pill btn--small">Сохранить</button></div>
        </form>
        <dl class="meta meta--stack meta--spaced">
            <div><dt>Так будет выглядеть надпись</dt><dd>{{ watermark_sample.main }}</dd></div>
            <div><dt>Строка внизу страницы</dt><dd>{{ watermark_sample.footer }}</dd></div>
        </dl>
        <p class="form-help">Знак ставится на файлы PDF и на предпросмотр офисных файлов. Исходные Word, Excel и другие файлы скачиваются как есть;
            страницы портала показываются в браузере. Сборники разделов получают знак в режимах «закрытые от гостей» и «все»,
            если знак ставится и модераторам. Файлы крупнее 200 МБ отдаются без знака.</p>
    </div>
</div>
{% endblock %}
