{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}Статистика — {{ document.title }}{% endblock %}

{% block body %}
<section class="hero hero--compact">
    <div class="container">
        {{ m.breadcrumbs(document.section, document.title ~ ' — статистика') }}
        <div class="hero__row">
            <div>
                <h1 class="h-display">Статистика документа</h1>
                <p class="hero__meta">{{ document.title }} · {{ m.status_badge(document) }} {{ m.validity_badge(document, true) }}</p>
            </div>
            <div class="hero__actions"><a class="btn btn--ghost" href="{{ path('app_document_show', {id: document.id}) }}">К документу</a></div>
        </div>
    </div>
</section>
<section class="container section">
    <div class="grid grid--stats">
        <div class="card"><div class="stat__label">Просмотров всего</div><div class="stat__value">{{ stats.summary.views }}</div><div class="stat__hint">за 30 дней: {{ stats.views_30d }}</div></div>
        <div class="card"><div class="stat__label">Скачиваний всего</div><div class="stat__value">{{ stats.summary.downloads }}</div><div class="stat__hint">за 30 дней: {{ stats.downloads_30d }}</div></div>
        <div class="card"><div class="stat__label">Уникальных читателей</div><div class="stat__value">{{ stats.summary.unique_users }}</div><div class="stat__hint">пользователей, открывавших документ</div></div>
        <div class="card"><div class="stat__label">Версий</div><div class="stat__value">{{ document.versions|length }}</div><div class="stat__hint">текущая: v{{ document.currentVersion ? document.currentVersion.number : '—' }}</div></div>
        <div class="card"><div class="stat__label">Актуальность</div><div class="stat__value stat__value--text {{ stats.validity == 'expired' ? 'text-danger' : (stats.validity == 'soon' ? 'text-warning' : '') }}">{{ stats.validity|validity_label }}</div><div class="stat__hint">{{ stats.validity_text }}</div></div>
    </div>

    <div class="card">
        <div class="card__head"><h2 class="h-section">Активность за 30 дней</h2><span class="text-muted">{% if stats.summary.last %}последний просмотр/скачивание: {{ stats.summary.last|date('d.m.Y H:i') }}{% endif %}</span></div>
        {{ m.bar_chart(chart) }}
    </div>

    <div class="grid grid--two">
        <div class="card table-card">
            <div class="card__head card__head--padded"><h2 class="h-section">Кто читает</h2></div>
            {% if stats.users|length == 0 %}<div class="table-card__empty">Документ ещё никто не открывал.</div>{% else %}
            <div class="table-scroll"><table class="admin-table">
                <thead><tr><th>Пользователь</th><th class="col-num">Просм.</th><th class="col-num">Скач.</th><th>Последний раз</th></tr></thead>
                <tbody>{% for u in stats.users %}<tr><td>{{ u.name }}{% if u.username %}<div class="hints">{{ u.username }}</div>{% endif %}</td><td class="col-num">{{ u.views }}</td><td class="col-num">{{ u.downloads }}</td><td class="col-nowrap">{{ u.last|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody>
            </table></div>{% endif %}
        </div>
        <div class="card table-card">
            <div class="card__head card__head--padded"><h2 class="h-section">Скачивания по версиям</h2></div>
            <div class="table-scroll"><table class="admin-table">
                <thead><tr><th>Версия</th><th>Дата</th><th>Автор</th><th class="col-num">Скач.</th></tr></thead>
                <tbody>{% for row in stats.versions %}<tr class="{{ row.version.current ? 'is-published' }}"><td>v{{ row.version.number }}{% if row.version.current %} <span class="tag">текущая</span>{% endif %}</td><td class="col-nowrap">{{ row.version.createdAt|date('d.m.Y') }}</td><td>{{ row.version.createdBy ? row.version.createdBy.displayName : '—' }}</td><td class="col-num">{{ row.downloads }}</td></tr>{% endfor %}</tbody>
            </table></div>
        </div>
    </div>

    <div class="card table-card">
        <div class="card__head card__head--padded"><h2 class="h-section">Журнал событий</h2>{% if is_granted('ROLE_ADMIN') %}<a class="link-action" href="{{ path('admin_events', {document: document.id}) }}">Полный журнал</a>{% endif %}</div>
        <div class="table-scroll"><table class="admin-table">
            <thead><tr><th>Когда</th><th>Событие</th><th>Кто</th><th>Подробности</th></tr></thead>
            <tbody>
            {% for e in stats.events %}
                <tr><td class="col-nowrap">{{ e.createdAt|date('d.m.Y H:i') }}</td><td>{{ e.type|event_label }}{% if e.version %} <span class="tag">v{{ e.version.number }}</span>{% endif %}</td><td>{{ e.actorName ?: 'система' }}</td><td class="col-comment">{% if e.details %}{% for k, v in e.details %}{{ k }}: {{ v is iterable ? v|join(', ') : v }}{{ not loop.last ? '; ' }}{% endfor %}{% endif %}{% if e.ip %}<div class="hints">{{ e.ip }}</div>{% endif %}</td></tr>
            {% endfor %}
            </tbody>
        </table></div>
    </div>
</section>
{% endblock %}
