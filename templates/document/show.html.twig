{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as m %}

{% block title %}{{ document.title }}{% endblock %}
{% block body_class %}page-document{% endblock %}

{% block body %}
<section class="hero hero--compact">
    <div class="container">
        {{ m.breadcrumbs(document.section, document.title) }}
        <div class="hero__row">
            <div class="doc-head">
                <div class="doc-head__icon">{{ m.file_icon(document) }}</div>
                <div>
                    <div class="doc-head__badges">
                        {{ m.status_badge(document) }}
                        {% if app.user and not document.public %}{{ m.access_badge(document) }}{% endif %}
                        {{ m.restricted_badge(document) }}
                        {{ m.validity_badge(document, true) }}
                        {% if document.code %}<span class="badge badge--code">{{ document.code }}</span>{% endif %}
                    </div>
                    <h1 class="h-display doc-head__title">{{ document.title }}</h1>
                    <p class="hero__meta">
                        {{ document.type|type_label }}{% if current %} · версия {{ current.number }} от {{ current.createdAt|date('d.m.Y') }}{% if current.file and current.size %} · {{ current.size|filesize }}{% endif %}{% endif %}
                        {% if document.owner %} · ответственный: {{ document.owner.displayName }}{% endif %}
                    </p>
                </div>
            </div>
            <div class="hero__actions">
                {% if current %}
                    {% if document.file %}
                        <a class="btn btn--pill" href="{{ path('app_document_download', {id: document.id}) }}">Скачать{% if current.extension %} {{ current.extension|upper }}{% endif %}</a>
                        {% if inline and file_exists %}<a class="btn btn--ghost" href="{{ path('app_document_download', {id: document.id, inline: 1}) }}" target="_blank" rel="noopener">Открыть в браузере</a>{% endif %}
                    {% else %}
                        <a class="btn btn--ghost" href="{{ path('app_document_download', {id: document.id}) }}">Скачать как HTML</a>
                    {% endif %}
                {% endif %}
                {% if can_manage %}
                    <a class="btn btn--ghost" href="{{ path('app_document_edit', {id: document.id}) }}">{{ document.file ? 'Изменить / новая версия' : 'Редактировать' }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<section class="container section">
    {% include '_flashes.html.twig' %}

    {% if document.draft %}
        <div class="alert alert--info">Это черновик: его видят только модераторы раздела и администраторы. {% if can_manage %}{{ approval_required ? 'Отправьте документ на согласование — после согласования его можно опубликовать.' : 'Опубликуйте документ, чтобы он стал доступен всем сотрудникам.' }}{% endif %}</div>
    {% elseif document.onReview %}
        <div class="alert alert--warning">Документ на согласовании{% if approval %} у {{ approval.approver.displayName }} (с {{ approval.requestedAt|date('d.m.Y H:i') }}){% endif %}: сотрудникам он пока не виден.</div>
    {% elseif document.archived %}
        <div class="alert alert--warning">Документ в архиве: он снят с публикации и сохранён для истории.</div>
    {% endif %}
    {% set vstate = document|validity_state %}
    {% if vstate == 'expired' %}
        <div class="alert alert--danger">Срок актуальности документа истёк ({{ document.validUntil|date('d.m.Y') }}). Уточните у ответственного, действует ли документ.</div>
    {% elseif vstate == 'soon' %}
        <div class="alert alert--warning">Срок актуальности {{ document|validity_text }}.</div>
    {% endif %}
    {% if not file_exists %}
        <div class="alert alert--danger">Файл текущей версии не найден в хранилище. Сообщите администратору.</div>
    {% endif %}

    {% if document.restricted and can_manage %}
        <div class="alert alert--info">Ограниченный доступ: документ видят
            {% if document.allowedUsers|length > 0 %}{{ document.allowedUsers|map(u => u.displayName)|join(', ') }}{% endif %}
            {%- if document.allowedUsers|length > 0 and document.allowedDepartments|length > 0 %}, {% endif -%}
            {% if document.allowedDepartments|length > 0 %}подразделения: {{ document.allowedDepartments|join(', ') }}{% endif %}
            {%- if document.allowedUsers|length == 0 and document.allowedDepartments|length == 0 %} только модераторы раздела и администраторы{% endif %} —
            а также модераторы раздела и администраторы.</div>
    {% endif %}

    {% if approval and approval.approver.id == app.user.id|default(0) %}
        <div class="ack-box">
            <p class="ack-box__title">Требуется ваше согласование</p>
            <p>Вам отправили на согласование редакцию {{ approval.versionNumber }} этого документа{% if approval.requestedBy %} — {{ approval.requestedBy.displayName }}, {{ approval.requestedAt|date('d.m.Y H:i') }}{% endif %}.
                {% if approval.requestNote %}<br>Комментарий: «{{ approval.requestNote }}»{% endif %}</p>
            <form method="post" action="{{ path('app_approval_decide', {id: approval.id}) }}" class="form ack-decide">
                <input type="hidden" name="_token" value="{{ csrf_token('approval_decide_' ~ approval.id) }}">
                <input class="form-control form-control--inline" type="text" name="note" maxlength="2000" placeholder="Комментарий (обязателен при отклонении)">
                <button type="submit" class="btn btn--pill" name="decision" value="approve">Согласовать</button>
                <button type="submit" class="btn btn--ghost btn--danger" name="decision" value="reject">Отклонить</button>
            </form>
        </div>
    {% elseif approval_decided and can_manage and not document.published %}
        <div class="ack-box {{ approval_decided.approved ? 'ack-box--done' }}">
            <p class="ack-box__title">{{ approval_decided.approved ? 'Редакция согласована' : 'Редакция отклонена при согласовании' }}</p>
            <p>{{ approval_decided.approver.displayName }}, {{ approval_decided.decidedAt|date('d.m.Y H:i') }}{% if approval_decided.decisionNote %}: «{{ approval_decided.decisionNote }}»{% endif %}.
                {% if approval_decided.approved %}Документ можно публиковать.{% else %}Внесите правки и отправьте документ на согласование заново.{% endif %}</p>
        </div>
    {% endif %}

    {% if acknowledgement %}
        <div class="ack-box">
            <p class="ack-box__title">Требуется ознакомление</p>
            <p>Вам назначено ознакомление с редакцией {{ acknowledgement.versionNumber }} этого документа{% if acknowledgement.dueAt %} — срок до <b>{{ acknowledgement.dueAt|date('d.m.Y') }}</b>{% if acknowledgement.isOverdue() %} <span class="text-danger">(просрочено)</span>{% endif %}{% endif %}. Прочитайте документ и подтвердите ознакомление — портал зафиксирует дату, время и номер редакции.</p>
            <form method="post" action="{{ path('app_document_acknowledge', {id: document.id}) }}" class="inline-form">
                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                <button type="submit" class="btn btn--pill">Ознакомлен</button>
            </form>
        </div>
    {% elseif acknowledged %}
        <div class="ack-box ack-box--done">
            <p class="ack-box__title">Вы ознакомлены с этим документом</p>
            <p>Подтверждено {{ acknowledged|date('d.m.Y H:i') }} (редакция {{ document.currentVersion ? document.currentVersion.number : '' }}). Запись сохранена в журнале и в отчёте по ознакомлению.</p>
        </div>
    {% endif %}

    <div class="grid grid--doc">
        <div class="doc-main">
            {% if document.description %}
                <div class="card">
                    <div class="card__head"><h2 class="h-section">Описание</h2>{% if document.descriptionGenerated %}<span class="ai-badge" title="Сформировано языковой моделью {{ document.descriptionGeneratedAt ? document.descriptionGeneratedAt|date('d.m.Y H:i') }}">ИИ</span>{% endif %}</div>
                    <p class="doc-description">{{ document.description|nl2br }}</p>
                    {% if document.descriptionGenerated %}<p class="form-help">Описание сформировано языковой моделью{% if document.descriptionGeneratedAt %} {{ document.descriptionGeneratedAt|date('d.m.Y') }}{% endif %} и может содержать неточности.{% if can_manage %} Отредактируйте его в карточке, если нужно — тогда пометка снимется.{% endif %}</p>{% endif %}
                </div>
            {% elseif llm_enabled|default(false) %}
                <div class="card">
                    <div class="card__head"><h2 class="h-section">Описание</h2></div>
                    <p class="text-muted">Описания пока нет. Его можно написать в карточке документа или сформировать языковой моделью.</p>
                </div>
            {% endif %}

            {% if current and document.page %}
                <div class="card">
                    <h2 class="h-section">Содержание</h2>
                    <div class="page-content">{{ current.content|raw }}</div>
                </div>
            {% elseif current and inline and file_exists %}
                <div class="card card--preview">
                    <div class="card__head"><h2 class="h-section">Предпросмотр</h2><a class="link-action" href="{{ path('app_document_download', {id: document.id, inline: 1}) }}" target="_blank" rel="noopener">Открыть на весь экран</a></div>
                    {% if current.extension in ['png', 'jpg', 'jpeg', 'gif', 'svg'] %}
                        <img class="preview-image" src="{{ path('app_document_download', {id: document.id, inline: 1}) }}" alt="{{ document.title }}">
                    {% else %}
                        <iframe class="preview-frame__iframe" src="{{ path('app_document_download', {id: document.id, inline: 1}) }}" title="Предпросмотр: {{ document.title }}" loading="lazy"></iframe>
                    {% endif %}
                </div>
            {% elseif current and previewable and file_exists %}
                <div class="card card--preview" id="preview">
                    <div class="card__head">
                        <h2 class="h-section">Предпросмотр</h2>
                        <a class="link-action" href="{{ path('app_document_preview', {id: document.id}) }}" target="_blank" rel="noopener">Открыть на весь экран</a>
                    </div>
                    {% if preview_ready %}
                        <iframe class="preview-frame__iframe" src="{{ path('app_document_preview', {id: document.id}) }}" title="Предпросмотр: {{ document.title }}" loading="lazy"></iframe>
                    {% else %}
                        <p class="text-muted">Файл {{ current.extension|upper }} можно посмотреть прямо в браузере — портал переведёт его в PDF (первый раз это занимает несколько секунд).</p>
                        <p><a class="btn btn--pill" href="{{ path('app_document_preview', {id: document.id}) }}" target="_blank" rel="noopener">Посмотреть в браузере</a></p>
                    {% endif %}
                </div>
            {% endif %}

            <div class="card table-card">
                <div class="card__head card__head--padded">
                    <h2 class="h-section">Версии <span class="tag">{{ versions|length }}</span></h2>
                    {% if versions|length > 1 and document.page %}
                        {% set vs = versions|slice(0, 2) %}
                        <a class="link-action" href="{{ path('app_document_compare', {id: document.id, a: vs[1].number, b: vs[0].number}) }}">Сравнить две последние</a>
                    {% endif %}
                </div>
                <div class="table-scroll">
                    <table class="admin-table versions-table">
                        <thead><tr><th>Версия</th><th>Дата</th><th>Автор</th><th>Что изменилось</th><th>{{ document.file ? 'Файл' : 'Размер' }}</th><th class="col-num">Скач.</th><th class="col-actions"></th></tr></thead>
                        <tbody>
                        {% for v in versions %}
                            <tr class="{{ v.current ? 'is-published' }}">
                                <td><b>v{{ v.number }}</b>{% if v.current %} <span class="tag">текущая</span>{% endif %}</td>
                                <td class="col-nowrap">{{ v.createdAt|date('d.m.Y H:i') }}</td>
                                <td>{{ v.createdBy ? v.createdBy.displayName : '—' }}</td>
                                <td class="col-comment">{{ v.changeNote ?: '—' }}</td>
                                <td>{% if v.file %}{{ v.originalName }}<div class="hints">{{ v.size ? v.size|filesize : '' }}</div>{% else %}{{ v.size ? v.size|filesize : '—' }}{% endif %}</td>
                                <td class="col-num">{{ v.downloadCount }}</td>
                                <td class="col-actions">
                                    <div class="actions">
                                        {% if v.file %}
                                            <a class="btn btn--ghost btn--small" href="{{ path('app_document_version_download', {id: document.id, number: v.number}) }}">Скачать</a>
                                            {% if preview_extensions is defined and v.extension|lower in preview_extensions %}<a class="btn btn--ghost btn--small" href="{{ path('app_document_version_preview', {id: document.id, number: v.number}) }}" target="_blank" rel="noopener">Посмотреть</a>{% endif %}
                                        {% else %}
                                            <a class="btn btn--ghost btn--small" href="{{ path('app_document_version', {id: document.id, number: v.number}) }}">Открыть</a>
                                            {% if not v.current and current %}<a class="btn btn--ghost btn--small" href="{{ path('app_document_compare', {id: document.id, a: v.number, b: current.number}) }}">Сравнить с текущей</a>{% endif %}
                                        {% endif %}
                                        {% if can_manage and not v.current %}
                                            <form method="post" action="{{ path('app_document_restore', {id: document.id, number: v.number}) }}" class="inline-form" data-confirm="Сделать версию {{ v.number }} текущей? Она будет скопирована как новая версия.">
                                                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                                                <button type="submit" class="btn btn--ghost btn--small">Восстановить</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {{ include('document/_links.html.twig') }}

            {% if comments_enabled %}
                {{ include('document/_comments.html.twig') }}
            {% endif %}
        </div>

        <aside class="doc-side">
            <div class="card">
                <h2 class="h-section">Карточка</h2>
                <dl class="meta meta--stack">
                    <div><dt>Раздел</dt><dd><a href="{{ path('app_section_show', {id: document.section.id}) }}">{{ document.section.fullName }}</a></dd></div>
                    {% if document.code %}<div><dt>Обозначение</dt><dd>{{ document.code }}</dd></div>{% endif %}
                    <div><dt>Актуальность</dt><dd>{{ document|validity_text|capitalize }}</dd></div>
                    {% if app.user %}<div><dt>Доступ</dt><dd>{{ document.public ? 'открытый — читается без входа в портал' : 'внутренний — только для сотрудников после входа' }}</dd></div>{% endif %}
                    <div><dt>Создан</dt><dd>{{ document.createdAt|date('d.m.Y') }}{% if document.owner %} · {{ document.owner.displayName }}{% endif %}</dd></div>
                    {% if document.publishedAt %}<div><dt>Опубликован</dt><dd>{{ document.publishedAt|date('d.m.Y H:i') }}</dd></div>{% endif %}
                    <div><dt>Обновлён</dt><dd>{{ document.updatedAt|date('d.m.Y H:i') }}</dd></div>
                    {% if document.tags|length > 0 %}
                        <div><dt>Теги</dt><dd class="tags">{% for t in document.tags %}<a class="tag tag--link" href="{{ path('app_search', {q: t}) }}">{{ t }}</a>{% endfor %}</dd></div>
                    {% endif %}
                    <div><dt>Статистика</dt><dd>{{ document.viewCount|plural(['просмотр', 'просмотра', 'просмотров']) }}, {{ document.downloadCount|plural(['скачивание', 'скачивания', 'скачиваний']) }}{% if can_manage %} — <a href="{{ path('app_document_stats', {id: document.id}) }}">подробнее</a>{% endif %}</dd></div>
                </dl>
            </div>

            {% if app.user and subscriptions_enabled %}
                <div class="card card--subscribe">
                    <h2 class="h-section">Уведомления</h2>
                    {% if subscribed %}
                        <p class="hints">Вы получаете уведомления об изменениях этого документа и о новых сообщениях в обсуждении.</p>
                    {% elseif subscribed_section %}
                        <p class="hints">Вы подписаны на раздел «{{ subscribed_section.fullName }}» — уведомления по этому документу уже приходят.</p>
                    {% else %}
                        <p class="hints">Подпишитесь, чтобы получать письмо (и сообщение в Telegram) при выходе новой редакции и при обсуждении.</p>
                    {% endif %}
                    <form method="post" action="{{ path('app_document_subscribe', {id: document.id}) }}" class="inline-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                        <button type="submit" class="btn btn--block {{ subscribed ? 'btn--ghost' : 'btn--pill' }}">{{ subscribed ? 'Отписаться' : 'Подписаться на изменения' }}</button>
                    </form>
                    <p class="hints"><a href="{{ path('app_profile_subscriptions') }}">Мои подписки и каналы уведомлений</a></p>
                </div>
            {% endif %}

            {% if can_manage %}
                <div class="card card--actions">
                    <h2 class="h-section">Управление</h2>
                    <div class="stack">
                        {% if not document.published %}
                            <form method="post" action="{{ path('app_document_publish', {id: document.id}) }}" class="inline-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                                <button type="submit" class="btn btn--pill btn--block" {{ can_publish ? '' : 'disabled' }} {{ can_publish ? '' : 'title="Сначала документ нужно согласовать"' }}>Опубликовать</button>
                            </form>
                            {% if current %}
                                {% if approval %}
                                    <form method="post" action="{{ path('app_approval_cancel', {id: approval.id}) }}" class="inline-form" data-confirm="Отозвать запрос согласования?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approval_decide_' ~ approval.id) }}">
                                        <button type="submit" class="btn btn--ghost btn--block">Отозвать согласование</button>
                                    </form>
                                {% else %}
                                    <a class="btn btn--ghost btn--block" href="{{ path('app_document_approval_request', {id: document.id}) }}">Отправить на согласование</a>
                                {% endif %}
                            {% endif %}
                        {% else %}
                            <form method="post" action="{{ path('app_document_unpublish', {id: document.id}) }}" class="inline-form" data-confirm="Снять документ с публикации? Он станет черновиком и пропадёт из списков для сотрудников.">
                                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                                <button type="submit" class="btn btn--ghost btn--block">Снять с публикации</button>
                            </form>
                        {% endif %}
                        {% if not document.archived %}
                            <form method="post" action="{{ path('app_document_archive', {id: document.id}) }}" class="inline-form" data-confirm="Перенести документ в архив?">
                                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                                <button type="submit" class="btn btn--ghost btn--block">В архив</button>
                            </form>
                        {% endif %}
                        {% if llm_enabled|default(false) and current %}
                            <form method="post" action="{{ path('app_document_describe', {id: document.id}) }}" class="inline-form" {% if document.description %}data-confirm="{{ document.descriptionGenerated ? 'Сформировать описание заново?' : 'Заменить описание, написанное вручную, на сформированное языковой моделью?' }}"{% endif %}>
                                <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                                <button type="submit" class="btn btn--ghost btn--block">{{ document.description ? 'Описать через ИИ заново' : 'Описать через ИИ' }}</button>
                            </form>
                        {% endif %}
                        {% if document.published and current %}
                            <a class="btn btn--ghost btn--block" href="{{ path(acknowledgement_summary and acknowledgement_summary.assigned > 0 ? 'app_document_acknowledgements' : 'app_document_acknowledge_assign', {id: document.id}) }}">Ознакомление{% if acknowledgement_summary and acknowledgement_summary.assigned > 0 %} ({{ acknowledgement_summary.confirmed }}/{{ acknowledgement_summary.assigned }}){% endif %}</a>
                            <a class="btn btn--ghost btn--block" href="{{ path('app_document_questions', {id: document.id}) }}">Проверка знаний{% if question_count > 0 %} ({{ question_count }}){% endif %}</a>
                        {% endif %}
                        <a class="btn btn--ghost btn--block" href="{{ path('app_document_stats', {id: document.id}) }}">Статистика документа</a>
                        <form method="post" action="{{ path('app_document_delete', {id: document.id}) }}" class="inline-form" data-confirm="Удалить документ «{{ document.title }}» со всеми {{ versions|length }} версиями? Действие необратимо.">
                            <input type="hidden" name="_token" value="{{ csrf_token('document_' ~ document.id) }}">
                            <button type="submit" class="btn btn--danger btn--block">Удалить документ</button>
                        </form>
                    </div>
                </div>

                {% if recent_events|length > 0 %}
                    <div class="card">
                        <h2 class="h-section">Последние события</h2>
                        <ul class="timeline">
                            {% for e in recent_events %}
                                <li class="timeline__item timeline__item--{{ e.type }}">
                                    <span class="timeline__when">{{ e.createdAt|date('d.m.Y H:i') }}</span>
                                    <span class="timeline__what">{{ e.type|event_label }}{% if e.version %} v{{ e.version.number }}{% endif %}</span>
                                    <span class="timeline__who">{{ e.actorName ?: 'система' }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            {% endif %}
        </aside>
    </div>
</section>
{% endblock %}
