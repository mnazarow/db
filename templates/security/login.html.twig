{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
<section class="login">
    <div class="login__decor" aria-hidden="true"></div>
    <div class="container login__container">
        <div class="login__card card">
            <div class="login__brand login__brand--wordmark">
                <img class="login__logo" src="{{ asset('img/logo.svg') }}" alt="{{ app_company }}" height="48">
                <div class="login__company">{{ app_company }}</div>
            </div>
            <h1 class="h-display login__title">Вход в портал</h1>
            <p class="login__lead">{{ app_name }}. Доступ только для сотрудников компании.</p>

            {% include '_flashes.html.twig' %}
            {% if kerberos_failed|default(false) %}
                <div class="alert alert--warning" role="status">Войти через Windows не удалось: браузер не передал учётную запись домена
                    (компьютер не в домене или адрес портала не добавлен в зону «Местная интрасеть»). Войдите по логину и паролю.</div>
            {% endif %}
            {% if error %}
                <div class="alert alert--danger" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="form" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="form-row">
                    <label class="form-label" for="username">Логин</label>
                    <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}" required autofocus autocomplete="username" autocapitalize="off" spellcheck="false">
                    {% if ldap_enabled %}<div class="form-help">Доменная учётная запись — как для входа в Windows (без указания домена).</div>{% endif %}
                </div>

                <div class="form-row">
                    <label class="form-label" for="password">Пароль</label>
                    <input class="form-control" type="password" id="password" name="_password" required autocomplete="current-password">
                </div>

                <div class="form-row form-row--check">
                    <label class="form-check">
                        <input type="checkbox" name="_remember_me" value="on">
                        <span>Запомнить меня на этом устройстве</span>
                    </label>
                </div>

                <button class="btn btn--pill btn--block" type="submit">Войти</button>
            </form>

            {% if sso_enabled or saml_enabled|default(false) or kerberos_enabled|default(false) %}
                <div class="login__divider"><span>или</span></div>
                {% if kerberos_enabled|default(false) %}
                    <a class="btn btn--ghost btn--block" href="{{ path('app_login_kerberos') }}" title="Без пароля — под учётной записью домена, с которой вы вошли в Windows">Войти через Windows</a>
                {% endif %}
                {% if sso_enabled %}
                    <a class="btn btn--ghost btn--block{{ kerberos_enabled|default(false) ? ' login__sso-second' }}" href="{{ path('app_login_sso') }}">{{ sso_button }}</a>
                {% endif %}
                {% if saml_enabled|default(false) %}
                    <a class="btn btn--ghost btn--block{{ kerberos_enabled|default(false) or sso_enabled ? ' login__sso-second' }}" href="{{ path('app_login_saml') }}">{{ saml_button }}</a>
                {% endif %}
            {% endif %}

            <p class="login__help">Нет доступа или забыли пароль? Обратитесь к администратору портала.</p>
        </div>
    </div>
</section>
{% endblock %}
