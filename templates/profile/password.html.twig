{% extends 'base.html.twig' %}

{% block title %}Смена пароля{% endblock %}

{% block body %}
<section class="hero hero--compact">
    <div class="container">
        <div class="eyebrow">Учётная запись</div>
        <h1 class="h-display">Смена пароля</h1>
    </div>
</section>
<section class="container section">
    {% include '_flashes.html.twig' %}
    {% if must_change %}<div class="alert alert--warning">Администратор выдал вам временный пароль. Задайте свой пароль, чтобы продолжить работу.</div>{% endif %}
    <div class="grid grid--two">
        <div class="card card--form">
            {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'form'}}) }}
                {{ form_row(form.currentPassword) }}
                {{ form_row(form.newPassword.first) }}
                {{ form_row(form.newPassword.second) }}
                <div class="form-actions">
                    <button type="submit" class="btn btn--pill">Сменить пароль</button>
                    {% if not must_change %}<a class="btn btn--ghost" href="{{ path('app_home') }}">Отмена</a>{% endif %}
                </div>
            {{ form_end(form) }}
        </div>
        <div class="card card--info">
            <h2 class="h-section">Требования</h2>
            <ul class="bullets bullets--small">
                <li>Длина — не менее {{ min_length }} символов; лучше использовать фразу из нескольких слов.</li>
                <li>Не используйте пароли от других систем.</li>
                <li>Если вы забыли пароль, обратитесь к администратору — он выдаст временный.</li>
            </ul>
        </div>
    </div>
</section>
{% endblock %}
