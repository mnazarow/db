# ==============================================================================
#  Настройки по умолчанию портала документации (файл входит в поставку,
#  НЕ редактируйте его на сервере). Переопределяйте значения в файле .env.local
#  (создаётся скриптом установки) или переменными окружения (docker-compose.yml).
#  Приоритет: переменные окружения > .env.local > .env
# ==============================================================================

# --- Приложение ---------------------------------------------------------------
# Режим: prod (боевой) или dev (разработка, подробные ошибки на экране).
APP_ENV=prod
# Отладка: 0 — выключена (обязательно для боевого сервера), 1 — включена.
APP_DEBUG=0
# Секрет для подписи сессий, CSRF-токенов и cookie «Запомнить меня».
# Обязательно замените на случайную строку (скрипт установки делает это сам).
APP_SECRET=change_me_to_a_random_64_hex_string
# Название портала и компании (шапка, заголовок окна, подвал, письма).
APP_NAME="Портал документации"
APP_COMPANY="ВОДОКОМФОРТ"
# Публичный адрес портала (абсолютные ссылки в письмах и консольных командах).
APP_DEFAULT_URI=http://localhost
# Часовой пояс сервера приложения (расчёт «сегодня» для сроков актуальности, время в журналах).
APP_TIMEZONE=Europe/Moscow

# --- База данных ---------------------------------------------------------------
# Формат: mysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА?serverVersion=8.0&charset=utf8mb4
# Для MariaDB укажите serverVersion=10.11.0-MariaDB (версию вашего сервера).
DATABASE_URL="mysql://docportal:password@127.0.0.1:3306/docportal?serverVersion=8.0&charset=utf8mb4"

# --- Хранилище документов -----------------------------------------------------
# Каталог, где хранятся файлы всех версий документов (вне public/, недоступен напрямую).
STORAGE_DIR=%kernel.project_dir%/var/storage
# Максимальный размер загружаемого файла в мегабайтах (не больше upload_max_filesize в php.ini).
UPLOAD_MAX_MB=50
# Разрешённые расширения файлов (через запятую, без точек).
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,txt,csv,md,png,jpg,jpeg,gif,svg,zip,7z,rar,dwg,dxf,xml,json
# Каталог импорта: сюда на сервер копируют папки с документами (SFTP, SMB, scp), затем администратор
# запускает импорт в панели администратора («Импорт из каталога») или командой app:import:directory.
# Дерево папок становится деревом разделов, файлы — документами.
IMPORT_DIR=%kernel.project_dir%/var/import

# --- Актуальность документов ---------------------------------------------------
# За сколько дней до окончания срока актуальности документ считается «истекающим»
# (подсветка в списках, уведомления ответственным).
EXPIRY_SOON_DAYS=30
# Срок актуальности, который подставляется по умолчанию в форму нового документа (в месяцах; 0 — не подставлять).
DEFAULT_VALIDITY_MONTHS=12

# --- Почтовые уведомления -------------------------------------------------------
# Транспорт Symfony Mailer. null://null — письма не отправляются (только журнал).
# Примеры: smtp://user:pass@mail.example.ru:587  |  smtp://mail.example.ru:25?verify_peer=0
MAILER_DSN=null://null
# Отправитель писем.
MAIL_FROM="Портал документации <noreply@example.ru>"
# Отправлять ли администраторам сводку по истекающим документам (1 — да, 0 — нет).
NOTIFY_ADMINS=1

# --- Active Directory / LDAP ---------------------------------------------------
# 1 — включить вход по доменным учётным записям (нужно расширение PHP ldap).
LDAP_ENABLED=0
# Контроллер домена: адрес, порт и шифрование (none | ssl | tls).
LDAP_HOST=dc.example.local
LDAP_PORT=389
LDAP_ENCRYPTION=none
# Корень поиска пользователей.
LDAP_BASE_DN="DC=example,DC=local"
# Служебная учётная запись для поиска пользователей (DN или user@domain) и её пароль.
# Если не задана, портал подключается к домену от имени входящего пользователя (см. LDAP_UPN_SUFFIX).
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
# Суффикс UPN для входа без служебной учётной записи: логин «ivanov» → «ivanov@example.local».
LDAP_UPN_SUFFIX="example.local"
# Атрибут логина и фильтр поиска ({username} и {uid_key} подставляются автоматически).
LDAP_UID_KEY=sAMAccountName
LDAP_FILTER="(&(objectClass=user)(objectCategory=person)({uid_key}={username}))"
# Атрибуты с отображаемым именем и почтой.
LDAP_NAME_ATTR=displayName
LDAP_MAIL_ATTR=mail
# Группа AD (DN), членам которой выдаются права администратора портала. Пусто — не используется.
LDAP_ADMIN_GROUP=""
# Группа AD (DN), членство в которой обязательно для входа. Пусто — могут входить все пользователи домена.
LDAP_USER_GROUP=""

# --- Гостевой доступ -------------------------------------------------------------
# Начальный режим просмотра открытых документов без входа (меняется в панели администратора → Настройки):
# all — с любых адресов, ip — только с указанных IP/подсетей, off — выключен (нужен вход).
GUEST_ACCESS_DEFAULT=all

# --- Интеграции -----------------------------------------------------------------
# Ключи REST API (/api/v1), webhook об изменениях и подключение к языковой модели (описания документов)
# настраиваются в панели администратора → Интеграции и хранятся в базе данных.
# Путь к утилите pdftotext (пакет poppler-utils) для извлечения текста из PDF; по умолчанию ищется в PATH.
#PDFTOTEXT_BIN=/usr/bin/pdftotext

# Предпросмотр офисных файлов в браузере: LibreOffice переводит docx/xlsx/pptx в PDF.
# Пакет ставится при установке ключом --with-preview либо позже: deploy/refresh.sh --with-preview.
#SOFFICE_BIN=/usr/bin/soffice
# Где хранить готовые предпросмотры (по умолчанию — в кэше приложения).
#PREVIEW_DIR=/opt/docportal/shared/preview

# Распознавание сканов (OCR) для поиска: включается в панели администратора → Настройки.
#TESSERACT_BIN=/usr/bin/tesseract
#PDFTOPPM_BIN=/usr/bin/pdftoppm
#OCR_LANGUAGES=rus+eng

# --- Безопасность --------------------------------------------------------------
# Минимальная длина пароля локальных пользователей.
PASSWORD_MIN_LENGTH=8
# Число неудачных попыток входа для пары «логин + IP» за интервал, после которого вход временно блокируется.
LOGIN_MAX_ATTEMPTS=5
# То же, но суммарно по IP-адресу (защита от перебора логинов).
LOGIN_MAX_ATTEMPTS_GLOBAL=25
# Интервал подсчёта попыток (например: "1 minute", "15 minutes", "1 hour").
LOGIN_ATTEMPT_INTERVAL="15 minutes"
# Время жизни сессии в секундах (43200 = 12 часов бездействия).
SESSION_LIFETIME=43200
# Срок действия cookie «Запомнить меня» в секундах (1209600 = 14 дней).
REMEMBER_ME_LIFETIME=1209600
# Доверенные прокси (IP или подсети через запятую), если портал стоит за nginx/Traefik/Cloudflare.
# Пусто — заголовки X-Forwarded-* игнорируются. Внутри Docker обычно: 172.16.0.0/12
TRUSTED_PROXIES=
